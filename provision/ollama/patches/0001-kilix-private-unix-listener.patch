diff --git a/cmd/kilix_listener.go b/cmd/kilix_listener.go
new file mode 100644
index 0000000..21fd654
--- /dev/null
+++ b/cmd/kilix_listener.go
@@ -0,0 +1,88 @@
+package cmd
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/ollama/ollama/envconfig"
+)
+
+const kilixUnixSocketEnv = "OLLAMA_KILIX_SOCKET"
+
+func listenServer() (net.Listener, error) {
+	path := os.Getenv(kilixUnixSocketEnv)
+	if path == "" {
+		return net.Listen("tcp", envconfig.Host().Host)
+	}
+	return listenKilixUnix(path)
+}
+
+func listenKilixUnix(path string) (*net.UnixListener, error) {
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path {
+		return nil, fmt.Errorf("%s must be an absolute, clean path", kilixUnixSocketEnv)
+	}
+	if len([]byte(path)) > 107 {
+		return nil, fmt.Errorf("%s exceeds the Linux Unix-socket path limit", kilixUnixSocketEnv)
+	}
+	if strings.IndexFunc(path, func(character rune) bool {
+		return character < 0x20 || character == 0x7f
+	}) >= 0 {
+		return nil, fmt.Errorf("%s contains a control character", kilixUnixSocketEnv)
+	}
+
+	parent := filepath.Dir(path)
+	parentInfo, err := os.Lstat(parent)
+	if err != nil {
+		return nil, fmt.Errorf("inspect Unix-socket parent: %w", err)
+	}
+	if parentInfo.Mode()&os.ModeSymlink != 0 || !parentInfo.IsDir() {
+		return nil, fmt.Errorf("Unix-socket parent is not a real directory")
+	}
+	if parentInfo.Mode().Perm() != 0o700 {
+		return nil, fmt.Errorf("Unix-socket parent must have mode 0700")
+	}
+	if _, err := os.Lstat(path); err == nil {
+		return nil, fmt.Errorf("refusing occupied Unix-socket path")
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return nil, fmt.Errorf("inspect Unix-socket path: %w", err)
+	}
+
+	listener, err := net.ListenUnix("unix", &net.UnixAddr{Name: path, Net: "unix"})
+	if err != nil {
+		return nil, err
+	}
+	// The supervising process removes only the inode it observed after
+	// readiness.  Never let net.UnixListener unlink a replacement pathname.
+	listener.SetUnlinkOnClose(false)
+	boundInfo, err := os.Lstat(path)
+	if err != nil {
+		listener.Close()
+		return nil, fmt.Errorf("inspect bound Unix socket: %w", err)
+	}
+	cleanup := func() {
+		listener.Close()
+		current, currentErr := os.Lstat(path)
+		if currentErr == nil && os.SameFile(boundInfo, current) {
+			_ = os.Remove(path)
+		}
+	}
+	if boundInfo.Mode().Type() != os.ModeSocket {
+		cleanup()
+		return nil, fmt.Errorf("bound Unix listener is not a socket")
+	}
+	if err := os.Chmod(path, 0o600); err != nil {
+		cleanup()
+		return nil, fmt.Errorf("secure Unix socket: %w", err)
+	}
+	securedInfo, err := os.Lstat(path)
+	if err != nil || !os.SameFile(boundInfo, securedInfo) ||
+		securedInfo.Mode().Type() != os.ModeSocket || securedInfo.Mode().Perm() != 0o600 {
+		cleanup()
+		return nil, fmt.Errorf("Unix socket changed while it was being secured")
+	}
+	return listener, nil
+}
