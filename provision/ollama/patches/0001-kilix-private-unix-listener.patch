@@ -0,0 +1,93 @@
+package cmd
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func shortPrivateDir(t *testing.T) string {
+	t.Helper()
+	directory, err := os.MkdirTemp("/tmp", "kilix-ollama-test-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(directory) })
+	if err := os.Chmod(directory, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	return directory
+}
+
+func TestListenKilixUnix(t *testing.T) {
+	directory := shortPrivateDir(t)
+	path := filepath.Join(directory, "ollama.sock")
+	listener, err := listenKilixUnix(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Lstat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Type() != os.ModeSocket || info.Mode().Perm() != 0o600 {
+		t.Fatalf("socket mode = %v, want socket 0600", info.Mode())
+	}
+	if listener.Addr().Network() != "unix" || listener.Addr().String() != path {
+		t.Fatalf("listener address = %v, want unix %s", listener.Addr(), path)
+	}
+	if err := listener.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Lstat(path); err != nil {
+		t.Fatalf("supervisor-owned socket path was unlinked on close: %v", err)
+	}
+}
+
+func TestListenKilixUnixRefusesUnsafePaths(t *testing.T) {
+	private := shortPrivateDir(t)
+	occupied := filepath.Join(private, "occupied")
+	if err := os.WriteFile(occupied, []byte("keep"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	openParent := filepath.Join(private, "open")
+	if err := os.Mkdir(openParent, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(openParent, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	cases := []string{
+		"relative.sock",
+		filepath.Join(private, "bad\nname"),
+		filepath.Join(private, strings.Repeat("x", 108)),
+		filepath.Join(openParent, "ollama.sock"),
+		occupied,
+	}
+	for _, path := range cases {
+		t.Run(path, func(t *testing.T) {
+			listener, err := listenKilixUnix(path)
+			if err == nil {
+				listener.Close()
+				t.Fatalf("listenKilixUnix(%q) unexpectedly succeeded", path)
+			}
+		})
+	}
+	content, err := os.ReadFile(occupied)
+	if err != nil || string(content) != "keep" {
+		t.Fatalf("occupied path changed: content=%q err=%v", content, err)
+	}
+}
+
+func TestNoCloudServerCreatesNoRegistryIdentity(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("OLLAMA_NO_CLOUD", "1")
+	if err := initializeServerIdentity(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Lstat(filepath.Join(home, ".ollama")); !os.IsNotExist(err) {
+		t.Fatalf("no-cloud server created registry identity state: %v", err)
+	}
+}
