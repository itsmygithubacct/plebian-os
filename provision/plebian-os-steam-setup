#!/bin/bash
# Fixed Plebian OS transaction for Valve's stable Steam launcher policy.
#
# The packaged closure is deliberately unqualified in the current F102 tree.
# Mutating modes also require the F100-owned opaque pre-mutation
# kilix.install.authorization/v2 validation seam. Until both returns land,
# --install and --repair fail before the first system mutation.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

readonly PROGRAM=${0##*/}
readonly PRODUCTION_POLICY_ROOT=/usr/share/plebian-os/steam
readonly PRODUCTION_STATE_DIR=/var/lib/plebian-os/steam
readonly PRODUCTION_STAGING_ROOT=/var/lib/plebian-os/session
readonly PRODUCTION_KEYRING=/usr/share/keyrings/steam.gpg
readonly PRODUCTION_SOURCE=/etc/apt/sources.list.d/plebian-os-steam.sources
readonly PRODUCTION_PIN=/etc/apt/preferences.d/plebian-os-steam.pref
readonly PACKAGE_LIST='steam-launcher,steam-libs-amd64:amd64,steam-libs-i386:i386'

log()  { printf '\033[1;36m[steam-setup]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[steam-setup]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[steam-setup] %s\033[0m\n' "$*" >&2; exit 1; }

usage() {
    cat <<EOF
Usage: $PROGRAM --install|--repair|--verify
  --install  install the exact packaged Valve archive/i386 policy
  --repair   reconcile an interrupted transaction using the same authority
  --verify   read only: verify policy, architecture, packages, and provenance
EOF
}

[ "$#" -eq 1 ] || { usage >&2; exit 2; }
case "$1" in
    --install) MODE=install ;;
    --repair) MODE=repair ;;
    --verify) MODE=verify ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

# Test substitution is accepted only by an unprivileged process and all paths
# remain under one private, caller-owned root. A real root invocation always
# uses the installed policy and fixed system paths, regardless of environment.
TESTING=0
if [ "${PLEBIAN_OS_STEAM_TESTING:-0}" = 1 ]; then
    [ "$(id -u)" -ne 0 ] || die "Steam helper test mode is forbidden as root"
    TEST_ROOT=${PLEBIAN_OS_STEAM_TEST_ROOT:-}
    case "$TEST_ROOT" in /*) ;; *) die "test root must be absolute" ;; esac
    if [ ! -d "$TEST_ROOT" ] || [ -L "$TEST_ROOT" ]; then
        die "test root must be a real directory"
    fi
    [ "$(stat -c '%u:%a' -- "$TEST_ROOT" 2>/dev/null)" = "$(id -u):700" ] \
        || die "test root must be owned by the caller with mode 0700"
    TEST_ROOT_RESOLVED=$(readlink -f -- "$TEST_ROOT")
    [ "$TEST_ROOT_RESOLVED" = "$TEST_ROOT" ] \
        || die "test root may not contain a symlink"
    TESTING=1
fi

# Production commands never inherit caller-selected APT, dpkg, loader, GnuPG,
# proxy, shell-startup, or locale behavior. The eventual mediator must apply
# the same clean environment before exec so BASH_ENV cannot run pre-script;
# this second boundary protects every child command launched below.
if [ "$TESTING" = 0 ]; then
    while IFS= read -r name; do
        unset "$name"
    done < <(compgen -e)
    PATH=/usr/sbin:/usr/bin:/sbin:/bin
    HOME=/root
    USER=root
    LOGNAME=root
    LANG=C.UTF-8
    LC_ALL=C.UTF-8
    TZ=UTC
    export PATH HOME USER LOGNAME LANG LC_ALL TZ
fi

root_path() {
    if [ "$TESTING" = 1 ]; then
        printf '%s%s\n' "$TEST_ROOT" "$1"
    else
        printf '%s\n' "$1"
    fi
}

if [ "$TESTING" = 1 ]; then
    POLICY_ROOT="$TEST_ROOT/policy"
    STATE_DIR=$(root_path "$PRODUCTION_STATE_DIR")
    STAGING_ROOT=$(root_path "$PRODUCTION_STAGING_ROOT")
    KEYRING=$(root_path "$PRODUCTION_KEYRING")
    SOURCE=$(root_path "$PRODUCTION_SOURCE")
    PIN=$(root_path "$PRODUCTION_PIN")
    COMMAND_ROOT="$TEST_ROOT/test-bin"
    CLOSURE="$POLICY_ROOT/steam-closure.env"
    CLOSURE_PIN="$POLICY_ROOT/steam-closure.sha256"
    SOURCE_POLICY="$POLICY_ROOT/steam-source.sources"
    PIN_POLICY="$POLICY_ROOT/steam-pin.pref"
    POLICY_MANIFEST="$POLICY_ROOT/policy-v1.manifest"
else
    POLICY_ROOT=$PRODUCTION_POLICY_ROOT
    STATE_DIR=$PRODUCTION_STATE_DIR
    STAGING_ROOT=$PRODUCTION_STAGING_ROOT
    KEYRING=$PRODUCTION_KEYRING
    SOURCE=$PRODUCTION_SOURCE
    PIN=$PRODUCTION_PIN
    COMMAND_ROOT=/usr/bin
    CLOSURE="$POLICY_ROOT/steam-closure.env"
    CLOSURE_PIN="$POLICY_ROOT/steam-closure.sha256"
    SOURCE_POLICY="$POLICY_ROOT/steam-source.sources"
    PIN_POLICY="$POLICY_ROOT/steam-pin.pref"
    POLICY_MANIFEST="$POLICY_ROOT/policy-v1.manifest"
fi

DPKG="$COMMAND_ROOT/dpkg"
DPKG_QUERY="$COMMAND_ROOT/dpkg-query"
APT_GET="$COMMAND_ROOT/apt-get"
APT_CACHE="$COMMAND_ROOT/apt-cache"
CURL="$COMMAND_ROOT/curl"
GPG="$COMMAND_ROOT/gpg"
SHA256SUM="$COMMAND_ROOT/sha256sum"
TIMEOUT="$COMMAND_ROOT/timeout"
INSTALL="$COMMAND_ROOT/install"
FLOCK="$COMMAND_ROOT/flock"
SYNC="$COMMAND_ROOT/sync"

declare -A VALUES=()
readonly -a ALLOWED_KEYS=(
    STEAM_POLICY_VERSION
    STEAM_CLOSURE_QUALIFIED
    STEAM_BASE_SNAPSHOT
    STEAM_ARCHIVE_URI
    STEAM_ARCHIVE_SUITE
    STEAM_ARCHIVE_COMPONENT
    STEAM_KEY_URL
    STEAM_KEY_SHA256
    STEAM_KEY_FINGERPRINTS
    STEAM_SOURCE_SHA256
    STEAM_PIN_SHA256
    STEAM_PACKAGES
    STEAM_MAX_DOWNLOAD_BYTES
    STEAM_APT_TIMEOUT_SECONDS
    STEAM_OBSERVED_LAUNCHER_VERSION
    STEAM_OBSERVED_INRELEASE_SHA256
    STEAM_OBSERVED_AT
)

allowed_key() {
    local wanted=$1 key
    for key in "${ALLOWED_KEYS[@]}"; do
        [ "$wanted" != "$key" ] || return 0
    done
    return 1
}

require_root_owned_directory_ancestry() {
    local path=$1 owner mode parent
    [ "$TESTING" = 0 ] || return 0
    case "$path" in /*) ;; *) die "packaged policy ancestry is not absolute" ;; esac
    while :; do
        if [ ! -d "$path" ] || [ -L "$path" ]; then
            die "packaged policy ancestry is missing or symlinked"
        fi
        owner=$(stat -c '%u' -- "$path" 2>/dev/null) \
            || die "could not inspect packaged policy ancestry"
        mode=$(stat -c '%a' -- "$path" 2>/dev/null) \
            || die "could not inspect packaged policy ancestry"
        [ "$owner" = 0 ] \
            || die "packaged policy ancestry is not root-owned"
        (( (8#$mode & 8#022) == 0 )) \
            || die "packaged policy ancestry is writable by another user"
        [ "$path" != / ] || break
        parent=${path%/*}
        path=${parent:-/}
    done
}

require_safe_policy_file() {
    local path=$1 owner mode resolved
    if [ ! -f "$path" ] || [ -L "$path" ]; then
        die "packaged Steam policy file is missing or unsafe"
    fi
    if [ "$TESTING" = 0 ]; then
        resolved=$(readlink -e -- "$path" 2>/dev/null) \
            || die "could not resolve packaged Steam policy"
        [ "$resolved" = "$path" ] \
            || die "packaged Steam policy has a symlinked path"
        require_root_owned_directory_ancestry "${path%/*}"
        owner=$(stat -c '%u' -- "$path" 2>/dev/null) \
            || die "could not inspect packaged Steam policy"
        mode=$(stat -c '%a' -- "$path" 2>/dev/null) \
            || die "could not inspect packaged Steam policy"
        [ "$owner" = 0 ] || die "packaged Steam policy is not root-owned"
        (( (8#$mode & 8#022) == 0 )) \
            || die "packaged Steam policy is writable by another user"
    fi
}

parse_closure() {
    local line key value
    require_safe_policy_file "$CLOSURE"
    require_safe_policy_file "$CLOSURE_PIN"
    require_safe_policy_file "$SOURCE_POLICY"
    require_safe_policy_file "$PIN_POLICY"
    require_safe_policy_file "$POLICY_MANIFEST"
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) continue ;; esac
        case "$line" in *=*) ;; *) die "invalid Steam closure line" ;; esac
        key=${line%%=*}
        value=${line#*=}
        allowed_key "$key" || die "unknown Steam closure key: $key"
        [ -z "${VALUES[$key]+x}" ] || die "duplicate Steam closure key: $key"
        [ -n "$value" ] || die "empty Steam closure value: $key"
        case "$value" in *$'\n'*|*$'\r'*|*$'\t'*|*' '*)
            die "unsafe whitespace in Steam closure value: $key" ;;
        esac
        VALUES["$key"]=$value
    done <"$CLOSURE"
    for key in "${ALLOWED_KEYS[@]}"; do
        [ -n "${VALUES[$key]:-}" ] || die "Steam closure has no $key"
    done

    [ "${VALUES[STEAM_POLICY_VERSION]}" = 1 ] \
        || die "unsupported Steam policy version"
    [[ "${VALUES[STEAM_CLOSURE_QUALIFIED]}" =~ ^[01]$ ]] \
        || die "STEAM_CLOSURE_QUALIFIED must be 0 or 1"
    [ "${VALUES[STEAM_ARCHIVE_URI]}" = https://repo.steampowered.com/steam/ ] \
        || die "unexpected Valve archive URI"
    [ "${VALUES[STEAM_ARCHIVE_SUITE]}" = stable ] \
        || die "unexpected Valve archive suite"
    [ "${VALUES[STEAM_ARCHIVE_COMPONENT]}" = steam ] \
        || die "unexpected Valve archive component"
    [ "${VALUES[STEAM_KEY_URL]}" = \
        https://repo.steampowered.com/steam/archive/stable/steam.gpg ] \
        || die "unexpected Valve signing-key URL"
    [ "${VALUES[STEAM_PACKAGES]}" = "$PACKAGE_LIST" ] \
        || die "unexpected Steam package allowlist"
    for key in STEAM_KEY_SHA256 STEAM_SOURCE_SHA256 STEAM_PIN_SHA256 \
            STEAM_OBSERVED_INRELEASE_SHA256; do
        [[ "${VALUES[$key]}" =~ ^[0-9a-f]{64}$ ]] \
            || die "$key must be a lowercase SHA-256"
    done
    [[ "${VALUES[STEAM_KEY_FINGERPRINTS]}" =~ \
        ^[0-9A-F]{40}(,[0-9A-F]{40})*$ ]] \
        || die "Valve key fingerprints are malformed"
    [[ "${VALUES[STEAM_MAX_DOWNLOAD_BYTES]}" =~ ^[1-9][0-9]{0,11}$ ]] \
        || die "Steam download ceiling is invalid"
    [[ "${VALUES[STEAM_APT_TIMEOUT_SECONDS]}" =~ ^[1-9][0-9]{0,4}$ ]] \
        || die "Steam APT timeout is invalid"
}

file_sha256() {
    "$SHA256SUM" -- "$1" | awk '{print $1}'
}

verify_closure_digest() {
    local expected actual
    IFS= read -r expected <"$CLOSURE_PIN" \
        || die "could not read Steam closure digest"
    printf '%s\n' "$expected" | cmp -s - "$CLOSURE_PIN" \
        || die "Steam closure digest has trailing data"
    [[ "$expected" =~ ^[0-9a-f]{64}$ ]] \
        || die "Steam closure digest is malformed"
    actual=$(file_sha256 "$CLOSURE") \
        || die "could not hash Steam closure"
    [ "$actual" = "$expected" ] || die "Steam closure checksum mismatch"
    CLOSURE_SHA256=$actual
    [ "$(file_sha256 "$SOURCE_POLICY")" = "${VALUES[STEAM_SOURCE_SHA256]}" ] \
        || die "Steam source policy checksum mismatch"
    [ "$(file_sha256 "$PIN_POLICY")" = "${VALUES[STEAM_PIN_SHA256]}" ] \
        || die "Steam pin policy checksum mismatch"
    {
        printf 'schema=plebian-os.steam-policy/v1\n'
        printf 'authorization_schema=kilix.install.authorization/v2\n'
        printf 'architectures=amd64,i386\n'
        printf 'packages=%s\n' "$PACKAGE_LIST"
        printf 'helper_modes=install,repair,verify\n'
        printf 'archive_policy_sha256=%s\n' \
            "${VALUES[STEAM_SOURCE_SHA256]}"
        printf 'key_policy_sha256=%s\n' "${VALUES[STEAM_KEY_SHA256]}"
        printf 'pin_policy_sha256=%s\n' "${VALUES[STEAM_PIN_SHA256]}"
    } | cmp -s - "$POLICY_MANIFEST" \
        || die "Steam policy manifest bytes differ from the exact closure"
}

parse_closure
verify_closure_digest

architecture_is_supported() {
    [ "$("$DPKG" --print-architecture 2>/dev/null || true)" = amd64 ]
}

i386_enabled() {
    "$DPKG" --print-foreign-architectures 2>/dev/null \
        | grep -Fxq i386
}

package_installed() {
    # The format expression is dpkg-query data, not shell interpolation.
    # shellcheck disable=SC2016
    [ "$("$DPKG_QUERY" -W -f='${Status}' "$1" 2>/dev/null || true)" \
        = 'install ok installed' ]
}

package_version() {
    # The format expression is dpkg-query data, not shell interpolation.
    # shellcheck disable=SC2016
    "$DPKG_QUERY" -W -f='${Version}' "$1" 2>/dev/null || true
}

policy_target_exact() {
    local target=$1 expected=$2 owner mode resolved
    [ -f "$target" ] && [ ! -L "$target" ] \
        && [ "$(file_sha256 "$target" 2>/dev/null || true)" = "$expected" ] \
        || return 1
    if [ "$TESTING" = 0 ]; then
        resolved=$(readlink -e -- "$target" 2>/dev/null) || return 1
        [ "$resolved" = "$target" ] || return 1
        require_root_owned_directory_ancestry "${target%/*}"
        owner=$(stat -c '%u' -- "$target" 2>/dev/null) || return 1
        mode=$(stat -c '%a' -- "$target" 2>/dev/null) || return 1
        [ "$owner" = 0 ] || return 1
        (( (8#$mode & 8#022) == 0 )) || return 1
    fi
    return 0
}

keyring_exact() {
    policy_target_exact "$KEYRING" "${VALUES[STEAM_KEY_SHA256]}"
}

root_steam_processes_absent() {
    local process status command
    for process in /proc/[0-9]*; do
        if [ ! -r "$process/status" ]; then
            [ ! -d "$process" ] || return 1
            continue
        fi
        status=$(sed -n 's/^Uid:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
            "$process/status" 2>/dev/null) || {
                [ ! -d "$process" ] || return 1
                continue
            }
        if [ -z "$status" ]; then
            [ ! -d "$process" ] || return 1
            continue
        fi
        [ "$status" = 0 ] || continue
        if [ ! -r "$process/cmdline" ]; then
            [ ! -d "$process" ] || return 1
            continue
        fi
        command=$(tr '\0' ' ' <"$process/cmdline" 2>/dev/null) || {
            [ ! -d "$process" ] || return 1
            continue
        }
        case "$command" in
            /usr/bin/steam|/usr/bin/steam\ *|*/bin_steam.sh\ *|\
            */steamwebhelper\ *|*/steam\ *)
                return 1 ;;
        esac
    done
    return 0
}

installed_i386_count() {
    local rows
    # The format expression is dpkg-query data, not shell interpolation.
    # shellcheck disable=SC2016
    rows=$("$DPKG_QUERY" -W \
        -f='${binary:Package}\t${Architecture}\t${db:Status-Abbrev}\n' \
        2>/dev/null) || return 1
    printf '%s\n' "$rows" \
        | awk -F '\t' '$2 == "i386" && $3 == "ii " { count += 1 }
            END { print count + 0 }'
}

all_fixed_packages_installed() {
    local package
    for package in steam-launcher steam-libs-amd64:amd64 \
            steam-libs-i386:i386; do
        package_installed "$package" || return 1
    done
}

policy_version_has_exact_valve_origin() {
    local policy_output=$1 wanted=$2 architecture=$3
    printf '%s\n' "$policy_output" | awk \
        -v wanted="$wanted" -v architecture="$architecture" '
        $1 == "***" {
            active = ($2 == wanted)
            next
        }
        $1 == wanted && $2 ~ /^[0-9]+$/ {
            active = 1
            next
        }
        $1 !~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ {
            active = 0
        }
        active && $1 ~ /^[0-9]+$/ {
            if (($2 == "https://repo.steampowered.com/steam/" \
                    || $2 == "https://repo.steampowered.com/steam") \
                    && $3 == "stable/steam" && $4 == architecture \
                    && $5 == "Packages") {
                found = 1
            } else if ($2 != "/var/lib/dpkg/status") {
                bad = 1
            }
        }
        END { exit(found && !bad ? 0 : 1) }
    '
}

candidate_valve_version() {
    local package=$1 architecture=$2 policy_output candidate
    policy_output=$("$APT_CACHE" policy "$package" 2>/dev/null) || return 1
    candidate=$(printf '%s\n' "$policy_output" \
        | awk '$1 == "Candidate:" { print $2; exit }')
    [[ "$candidate" =~ ^[0-9A-Za-z.+:~_-]+$ ]] || return 1
    policy_version_has_exact_valve_origin \
        "$policy_output" "$candidate" "$architecture" || return 1
    printf '%s\n' "$candidate"
}

installed_package_provenance_exact() {
    local package=$1 architecture=$2 installed policy_output
    installed=$(package_version "$package")
    [ -n "$installed" ] || return 1
    policy_output=$("$APT_CACHE" policy "$package" 2>/dev/null) || return 1
    policy_version_has_exact_valve_origin \
        "$policy_output" "$installed" "$architecture"
}

verify_core() {
    local failed=0 package package_spec architecture
    architecture_is_supported \
        || { warn "Steam policy supports amd64 only"; failed=1; }
    [ "${VALUES[STEAM_CLOSURE_QUALIFIED]}" = 1 ] \
        || { warn "Steam package closure is not independently qualified"; failed=1; }
    policy_target_exact "$SOURCE" "${VALUES[STEAM_SOURCE_SHA256]}" \
        || { warn "dedicated Valve source is absent or different"; failed=1; }
    policy_target_exact "$PIN" "${VALUES[STEAM_PIN_SHA256]}" \
        || { warn "dedicated Valve package pin is absent or different"; failed=1; }
    keyring_exact \
        || { warn "dedicated Valve keyring is absent or different"; failed=1; }
    i386_enabled \
        || { warn "i386 is not enabled"; failed=1; }
    for package in steam-launcher steam-libs-amd64:amd64 steam-libs-i386:i386; do
        package_installed "$package" \
            || { warn "$package is not installed"; failed=1; }
    done
    if [ ! -x "$APT_CACHE" ]; then
        warn "fixed apt-cache is unavailable for Steam provenance"
        failed=1
    else
        for package_spec in steam-launcher:amd64 \
                steam-libs-amd64:amd64:amd64 steam-libs-i386:i386:i386; do
            architecture=${package_spec##*:}
            package=${package_spec%:*}
            installed_package_provenance_exact "$package" "$architecture" \
                || { warn "installed $package version is not available only from the Valve stable archive"; failed=1; }
        done
    fi
    root_steam_processes_absent \
        || { warn "a Steam process is running as root"; failed=1; }
    [ "$failed" = 0 ]
}

state_file_safe() {
    local path=$1 boundary trusted_uid resolved directory owner mode parent
    [ -f "$path" ] && [ ! -L "$path" ] || return 1
    resolved=$(readlink -e -- "$path" 2>/dev/null) || return 1
    [ "$resolved" = "$path" ] || return 1
    if [ "$TESTING" = 1 ]; then
        boundary=$TEST_ROOT
        trusted_uid=$(id -u)
    else
        boundary=/
        trusted_uid=0
    fi
    directory=${path%/*}
    if [ "$boundary" = / ]; then
        case "$directory" in /*) ;; *) return 1 ;; esac
    else
        case "$directory" in
            "$boundary"|"$boundary"/*) ;;
            *) return 1 ;;
        esac
    fi
    while :; do
        [ -d "$directory" ] && [ ! -L "$directory" ] || return 1
        owner=$(stat -c '%u' -- "$directory" 2>/dev/null) || return 1
        mode=$(stat -c '%a' -- "$directory" 2>/dev/null) || return 1
        [ "$owner" = "$trusted_uid" ] || return 1
        (( (8#$mode & 8#022) == 0 )) || return 1
        [ "$directory" != "$boundary" ] || break
        parent=${directory%/*}
        directory=${parent:-/}
    done
    owner=$(stat -c '%u' -- "$path" 2>/dev/null) || return 1
    mode=$(stat -c '%a' -- "$path" 2>/dev/null) || return 1
    [ "$owner" = "$trusted_uid" ] || return 1
    [ "$mode" = 644 ]
}

verified_outcome_exact() {
    local outcome=$1 index
    local -a lines=()
    state_file_safe "$outcome" || return 1
    mapfile -t lines <"$outcome" || return 1
    [ "${#lines[@]}" = 10 ] || return 1
    [ "${lines[0]}" = 'schema=plebian-os.steam-transaction/v1' ] \
        && [ "${lines[1]}" = 'state=VERIFIED' ] \
        && [ "${lines[2]}" = "closure_sha256=$CLOSURE_SHA256" ] \
        && [ "${lines[3]}" = \
            'authorization_schema=kilix.install.authorization/v2' ] \
        && [ "${lines[4]}" = 'license_schema=kilix.install.license/v1' ] \
        && [ "${lines[5]}" = 'decisions_separate=1' ] \
        || return 1
    for index in 6 7 8 9; do
        [[ "${lines[$index]}" =~ ^introduced_(source|pin|key|i386)=[01]$ ]] \
            || return 1
    done
    [ "${lines[6]%%=*}" = introduced_source ] \
        && [ "${lines[7]%%=*}" = introduced_pin ] \
        && [ "${lines[8]%%=*}" = introduced_key ] \
        && [ "${lines[9]%%=*}" = introduced_i386 ] \
        || return 1
    {
        printf 'schema=plebian-os.steam-transaction/v1\n'
        printf 'state=VERIFIED\n'
        printf 'closure_sha256=%s\n' "$CLOSURE_SHA256"
        printf 'authorization_schema=kilix.install.authorization/v2\n'
        printf 'license_schema=kilix.install.license/v1\n'
        printf 'decisions_separate=1\n'
        printf '%s\n' "${lines[6]}" "${lines[7]}" \
            "${lines[8]}" "${lines[9]}"
    } | cmp -s - "$outcome"
}

verify_install() {
    local outcome
    verify_core || return 1
    outcome="$STATE_DIR/outcome"
    if ! verified_outcome_exact "$outcome"; then
        warn "verified Steam transaction outcome is absent or different"
        return 1
    fi
    log "Steam system layer is verified; no Steam process ran as root"
}

if [ "$MODE" = verify ]; then
    verify_install
    exit $?
fi

[ "$(id -u)" = 0 ] || [ "$TESTING" = 1 ] \
    || die "mutating Steam setup must run through the approved mediator"
[ "${VALUES[STEAM_CLOSURE_QUALIFIED]}" = 1 ] \
    || die "Steam package closure is unqualified; no system changes made"

validate_mediator_authority() {
    if [ "$TESTING" = 1 ] \
            && [ "${PLEBIAN_OS_STEAM_TEST_AUTHORIZATION_V2:-}" \
                = kilix.install.authorization/v2:test-only ]; then
        return 0
    fi
    # F100 owns the opaque handle, validation API, replay protection, and
    # durable positive record. Do not replace this refusal with an environment
    # token, JSON path, identifier reinterpretation, or license-v1 receipt.
    die "pre-mutation authorization-v2 mediator is unavailable; no system changes made"
}

validate_mediator_authority

for command in "$DPKG" "$DPKG_QUERY" "$APT_GET" "$APT_CACHE" "$CURL" \
        "$GPG" "$SHA256SUM" "$TIMEOUT" "$INSTALL" "$FLOCK" "$SYNC"; do
    [ -x "$command" ] || die "required fixed helper command is unavailable"
done
architecture_is_supported || die "Steam policy supports amd64 only"

secure_directory() {
    local path=$1 mode=${2:-0700} expected_mode
    if [ -e "$path" ] || [ -L "$path" ]; then
        if [ ! -d "$path" ] || [ -L "$path" ]; then
            die "Steam transaction directory is unsafe"
        fi
    else
        "$INSTALL" -d -m "$mode" -- "$path"
    fi
    chmod "$mode" -- "$path"
    if [ "$TESTING" = 0 ]; then
        chown root:root -- "$path"
        [ "$(stat -c '%u' -- "$path")" = 0 ] \
            || die "Steam transaction directory is not root-owned"
    fi
    expected_mode=${mode#0}
    [ "$(stat -c '%a' -- "$path")" = "$expected_mode" ] \
        || die "Steam transaction directory mode differs from policy"
    (( (8#$expected_mode & 8#022) == 0 )) \
        || die "Steam transaction directory is writable by another user"
}

secure_parent_directory() {
    local path=$1 owner mode
    if [ -e "$path" ] || [ -L "$path" ]; then
        if [ ! -d "$path" ] || [ -L "$path" ]; then
            die "Steam transaction parent is unsafe"
        fi
    else
        "$INSTALL" -d -m 0755 -- "$path"
    fi
    mode=$(stat -c '%a' -- "$path")
    (( (8#$mode & 8#022) == 0 )) \
        || die "Steam transaction parent is writable by another user"
    if [ "$TESTING" = 0 ]; then
        owner=$(stat -c '%u' -- "$path")
        [ "$owner" = 0 ] || die "Steam transaction parent is not root-owned"
        require_root_owned_directory_ancestry "$path"
    fi
}

secure_parent_directory "$(dirname "$STATE_DIR")"
secure_directory "$STATE_DIR" 0755
secure_directory "$STAGING_ROOT"
exec {TRANSACTION_LOCK_FD}>"$STATE_DIR/transaction.lock"
"$FLOCK" -n "$TRANSACTION_LOCK_FD" \
    || die "another Steam system transaction is already running"
chmod 0600 "$STATE_DIR/transaction.lock"

stage=$(mktemp -d "$STAGING_ROOT/steam.XXXXXX") \
    || die "could not create private Steam staging"
chmod 0700 "$stage"
TRANSACTION_ACTIVE=0
MUTATION_PHASE=0
INTRODUCED_SOURCE=0
INTRODUCED_PIN=0
INTRODUCED_KEY=0
INTRODUCED_I386=0

write_outcome() {
    local state=$1 temporary="$STATE_DIR/.outcome.$$"
    umask 077
    {
        printf 'schema=plebian-os.steam-transaction/v1\n'
        printf 'state=%s\n' "$state"
        printf 'closure_sha256=%s\n' "$CLOSURE_SHA256"
        printf 'authorization_schema=kilix.install.authorization/v2\n'
        printf 'license_schema=kilix.install.license/v1\n'
        printf 'decisions_separate=1\n'
        printf 'introduced_source=%s\n' "$INTRODUCED_SOURCE"
        printf 'introduced_pin=%s\n' "$INTRODUCED_PIN"
        printf 'introduced_key=%s\n' "$INTRODUCED_KEY"
        printf 'introduced_i386=%s\n' "$INTRODUCED_I386"
    } >"$temporary"
    # This is a redacted, root-authored verification projection consumed by
    # the unprivileged fixed SDK helper. It contains no opaque authorization
    # handle, account data, prompt text, or credential.
    chmod 0644 "$temporary"
    "$SYNC" -f "$temporary"
    mv -T -- "$temporary" "$STATE_DIR/outcome"
    "$SYNC" -f "$STATE_DIR"
}

remove_if_introduced() {
    local introduced=$1 path=$2
    if [ "$introduced" = 1 ]; then
        if [ ! -e "$path" ] && [ ! -L "$path" ]; then
            return 0
        fi
        [ -f "$path" ] && [ ! -L "$path" ] || return 1
        rm -f -- "$path" || return 1
    fi
    return 0
}

recover_transaction() {
    local i386_count recovery_failed=0
    set +e
    if [ "$MUTATION_PHASE" -lt 2 ]; then
        remove_if_introduced "$INTRODUCED_SOURCE" "$SOURCE" \
            || recovery_failed=1
        remove_if_introduced "$INTRODUCED_PIN" "$PIN" \
            || recovery_failed=1
        remove_if_introduced "$INTRODUCED_KEY" "$KEYRING" \
            || recovery_failed=1
        if [ "$INTRODUCED_I386" = 1 ]; then
            if i386_count=$(installed_i386_count); then
                if [ "$i386_count" = 0 ]; then
                    "$DPKG" --remove-architecture i386 >/dev/null 2>&1 \
                        || recovery_failed=1
                else
                    warn "i386 remains because $i386_count/$i386_count installed i386 packages exist"
                    recovery_failed=1
                fi
            else
                warn "i386 remains because the installed i386 population could not be proven 0/N"
                recovery_failed=1
            fi
        fi
        if [ "$recovery_failed" = 0 ]; then
            write_outcome RECOVERED_NO_CHANGE
        else
            write_outcome REPAIR_REQUIRED
            warn "Steam policy rollback was incomplete; fixed-policy repair is required"
        fi
    else
        write_outcome REPAIR_REQUIRED
        warn "Steam package mutation needs fixed-policy repair"
    fi
}

finish() {
    local status=$?
    if [ "$TRANSACTION_ACTIVE" = 1 ] && [ "$status" -ne 0 ]; then
        recover_transaction
    fi
    case "$stage" in "$STAGING_ROOT"/steam.*)
        [ -L "$stage" ] || rm -rf -- "$stage" ;;
    esac
    return "$status"
}
trap finish EXIT

classify_target() {
    local path=$1 expected=$2 label=$3
    if [ -e "$path" ] || [ -L "$path" ]; then
        if [ ! -f "$path" ] || [ -L "$path" ]; then
            die "$label path is not a regular file"
        fi
        [ "$(file_sha256 "$path")" = "$expected" ] \
            || die "$label conflicts with packaged Steam policy"
        printf 'exact\n'
    else
        printf 'absent\n'
    fi
}

SOURCE_PRESTATE=$(classify_target "$SOURCE" \
    "${VALUES[STEAM_SOURCE_SHA256]}" "Valve source")
PIN_PRESTATE=$(classify_target "$PIN" \
    "${VALUES[STEAM_PIN_SHA256]}" "Valve pin")
KEY_PRESTATE=$(classify_target "$KEYRING" \
    "${VALUES[STEAM_KEY_SHA256]}" "Valve keyring")
i386_enabled || INTRODUCED_I386=1
[ "$SOURCE_PRESTATE" = exact ] || INTRODUCED_SOURCE=1
[ "$PIN_PRESTATE" = exact ] || INTRODUCED_PIN=1
[ "$KEY_PRESTATE" = exact ] || INTRODUCED_KEY=1

TRANSACTION_ACTIVE=1
write_outcome PREPARED

"$CURL" --fail --location --silent --show-error --proto '=https' --tlsv1.2 \
    --max-filesize 65536 --connect-timeout 20 --max-time 120 \
    "${VALUES[STEAM_KEY_URL]}" --output "$stage/steam.gpg"
[ "$(file_sha256 "$stage/steam.gpg")" = "${VALUES[STEAM_KEY_SHA256]}" ] \
    || die "downloaded Valve keyring checksum mismatch"
OBSERVED_FINGERPRINTS=$("$GPG" --batch --no-default-keyring \
    --no-options --homedir "$stage" --keyring "$stage/empty.gpg" \
    --import-options show-only --with-colons \
    --import "$stage/steam.gpg" 2>/dev/null \
    | awk -F: '$1 == "pub" { primary=1; next }
        primary && $1 == "fpr" { if (out != "") out=out ","; out=out $10; primary=0 }
        END { print out }')
[ "$OBSERVED_FINGERPRINTS" = "${VALUES[STEAM_KEY_FINGERPRINTS]}" ] \
    || die "downloaded Valve key fingerprints differ from packaged policy"

publish_policy() {
    local source=$1 target=$2 mode=$3 expected=$4 temporary
    if policy_target_exact "$target" "$expected"; then
        return 0
    fi
    secure_parent_directory "$(dirname "$target")"
    temporary="$(dirname "$target")/.${target##*/}.$$.new"
    "$INSTALL" -m "$mode" -- "$source" "$temporary"
    [ "$(file_sha256 "$temporary")" = "$expected" ] \
        || die "staged Steam policy checksum mismatch"
    "$SYNC" -f "$temporary"
    mv -T -- "$temporary" "$target"
    "$SYNC" -f "$(dirname "$target")"
}

publish_policy "$stage/steam.gpg" "$KEYRING" 0644 \
    "${VALUES[STEAM_KEY_SHA256]}"
publish_policy "$SOURCE_POLICY" "$SOURCE" 0644 \
    "${VALUES[STEAM_SOURCE_SHA256]}"
publish_policy "$PIN_POLICY" "$PIN" 0644 "${VALUES[STEAM_PIN_SHA256]}"
MUTATION_PHASE=1

if ! i386_enabled; then
    "$DPKG" --add-architecture i386
fi
write_outcome SYSTEM_POLICY_PUBLISHED

readonly -a STEAM_PACKAGES=(
    steam-launcher
    steam-libs-amd64:amd64
    steam-libs-i386:i386
)
readonly -a STEAM_PACKAGE_SPECS=(
    'steam-launcher|amd64'
    'steam-libs-amd64:amd64|amd64'
    'steam-libs-i386:i386|i386'
)
declare -a STEAM_PACKAGE_ARGUMENTS=()
APT_TIMEOUT=${VALUES[STEAM_APT_TIMEOUT_SECONDS]}
"$TIMEOUT" --signal=TERM --kill-after=30 "$APT_TIMEOUT" \
    "$APT_GET" \
    -o 'DPkg::Lock::Timeout=0' \
    -o 'Acquire::Retries=0' \
    -o "Dir::Etc::sourcelist=$SOURCE" \
    -o 'Dir::Etc::sourceparts=-' \
    -o 'APT::Get::List-Cleanup=0' \
    -o 'Acquire::AllowInsecureRepositories=false' \
    -o 'Acquire::AllowDowngradeToInsecureRepositories=false' \
    update

for package_spec in "${STEAM_PACKAGE_SPECS[@]}"; do
    package=${package_spec%%|*}
    architecture=${package_spec#*|}
    candidate=$(candidate_valve_version "$package" "$architecture") \
        || die "could not resolve $package to one exact Valve stable candidate"
    STEAM_PACKAGE_ARGUMENTS+=("$package=$candidate")
done

URI_PLAN=$("$TIMEOUT" --signal=TERM --kill-after=30 "$APT_TIMEOUT" \
    "$APT_GET" -o 'DPkg::Lock::Timeout=0' -o 'Acquire::Retries=0' \
    --print-uris --yes --no-remove --no-install-recommends install \
    "${STEAM_PACKAGE_ARGUMENTS[@]}")
DOWNLOAD_BYTES=$(printf '%s\n' "$URI_PLAN" \
    | awk '
        $1 ~ /^'\''/ {
            rows += 1
            if ($1 !~ /^'\''https:\/\/[^'\'']+'\''$/ || $3 !~ /^[0-9]+$/) {
                bad = 1
            } else {
                total += $3
            }
        }
        END {
            if (bad) exit 1
            if (rows == 0) print "none"
            else print total + 0
        }') \
    || die "could not bound the Steam package download plan"
[ "$DOWNLOAD_BYTES" != none ] \
    || { all_fixed_packages_installed \
        || die "Steam package plan returned no downloads for an incomplete install"; \
         DOWNLOAD_BYTES=0; }
[ "$DOWNLOAD_BYTES" -le "${VALUES[STEAM_MAX_DOWNLOAD_BYTES]}" ] \
    || die "Steam package plan exceeds the packaged download ceiling"

MUTATION_PHASE=2
write_outcome SYSTEM_MUTATING
"$TIMEOUT" --signal=TERM --kill-after=30 "$APT_TIMEOUT" \
    "$APT_GET" -o 'DPkg::Lock::Timeout=0' -o 'Acquire::Retries=0' \
    --yes --no-remove --no-install-recommends install \
    "${STEAM_PACKAGE_ARGUMENTS[@]}"

verify_core || die "Steam system verification failed"
write_outcome VERIFIED
TRANSACTION_ACTIVE=0
log "Steam system layer installed and verified; launch remains unprivileged"
