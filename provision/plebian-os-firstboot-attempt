#!/bin/sh
# Persistently bound firstboot provisioning attempts across retries and reboots.
# Used by ExecCondition/ExecStart/ExecStartPost in the firstboot unit.
set -eu

state_dir="${PLEBIAN_OS_STATE_DIR:-/var/lib/plebian-os}"
attempt_file="$state_dir/firstboot-attempts"
max="${PLEBIAN_OS_FIRSTBOOT_MAX_ATTEMPTS:-3}"
attempt_timeout="${PLEBIAN_OS_FIRSTBOOT_ATTEMPT_TIMEOUT:-3600}"
retry_delay="${PLEBIAN_OS_FIRSTBOOT_RETRY_DELAY:-60}"
temporary_sudoers="${PLEBIAN_OS_TEMP_SUDOERS:-/etc/sudoers.d/plebian-os-provision}"

case "$max" in ''|*[!0-9]*|0) echo "invalid firstboot attempt limit: $max" >&2; exit 2 ;; esac
case "$attempt_timeout" in ''|*[!0-9]*|0) echo "invalid firstboot attempt timeout: $attempt_timeout" >&2; exit 2 ;; esac
case "$retry_delay" in *[!0-9]*|'') echo "invalid firstboot retry delay: $retry_delay" >&2; exit 2 ;; esac
case "$temporary_sudoers" in
    /*) ;;
    *) echo "temporary sudoers path must be absolute: $temporary_sudoers" >&2; exit 2 ;;
esac

read_attempts() {
    n=0
    if [ -e "$attempt_file" ]; then
        n="$(cat "$attempt_file" 2>/dev/null || true)"
        case "$n" in
            ''|*[!0-9]*) echo "corrupt firstboot attempt state: $attempt_file" >&2; return 1 ;;
        esac
    fi
    return 0
}

case "${1:-}" in
    check)
        read_attempts || exit 1
        if [ "$n" -ge "$max" ]; then
            echo "firstboot provisioning exhausted $n/$max attempts; remove $attempt_file after fixing the cause" >&2
            exit 1
        fi
        ;;
    begin)
        mkdir -p "$state_dir"
        read_attempts || exit 1
        [ "$n" -lt "$max" ] || exit 1
        tmp="$(mktemp "$state_dir/.firstboot-attempts.XXXXXX")"
        trap 'rm -f "$tmp"' EXIT HUP INT TERM
        n=$((n + 1))
        printf '%s\n' "$n" > "$tmp"
        chmod 0644 "$tmp"
        mv -f "$tmp" "$attempt_file"
        trap - EXIT HUP INT TERM
        echo "firstboot provisioning attempt $n/$max" >&2
        ;;
    success)
        rm -f "$attempt_file"
        ;;
    run)
        shift
        [ "$#" -gt 0 ] || {
            echo "usage: $0 run COMMAND [ARG ...]" >&2
            exit 2
        }
        command -v timeout >/dev/null 2>&1 || {
            echo "firstboot retry runner requires timeout" >&2
            exit 2
        }
        command_pid=""
        stop_status=0
        stop_attempt() {
            # Keep the unit's main process alive until the provisioner finishes
            # rollback. Otherwise systemd can reap its remaining control group
            # while package removal is still updating the dpkg database.
            [ "$stop_status" -eq 0 ] || return 0
            stop_status="$1"
            if [ -n "$command_pid" ]; then
                kill -s "$2" "$command_pid" 2>/dev/null || true
            else
                rm -f "$temporary_sudoers"
                exit "$stop_status"
            fi
        }
        trap 'stop_attempt 143 TERM' TERM
        trap 'stop_attempt 130 INT' INT
        trap 'stop_attempt 129 HUP' HUP
        while :; do
            read_attempts || exit 1
            if [ "$n" -ge "$max" ]; then
                echo "firstboot provisioning exhausted $n/$max attempts; remove $attempt_file after fixing the cause" >&2
                exit 1
            fi

            "$0" begin
            rm -f "$temporary_sudoers"
            echo "firstboot provisioning command has ${attempt_timeout}s to complete" >&2
            timeout --signal=TERM --kill-after=30s \
                "${attempt_timeout}s" "$@" &
            command_pid=$!
            while :; do
                if wait "$command_pid"; then
                    status=0
                    break
                else
                    status=$?
                fi
                # A caught signal interrupts wait before the child finishes.
                # Reap it before leaving; timeout retains the 30s KILL bound.
                if [ "$stop_status" -eq 0 ] || ! kill -0 "$command_pid" 2>/dev/null; then
                    break
                fi
            done
            command_pid=""
            rm -f "$temporary_sudoers"
            [ "$stop_status" -eq 0 ] || exit "$stop_status"
            [ "$status" -ne 0 ] || exit 0

            read_attempts || exit 1
            if [ "$n" -ge "$max" ]; then
                echo "firstboot provisioning exhausted $n/$max attempts (last exit $status)" >&2
                exit "$status"
            fi
            echo "firstboot provisioning attempt $n/$max failed (exit $status); retrying in ${retry_delay}s" >&2
            sleep "$retry_delay"
        done
        ;;
    *)
        echo "usage: $0 check|begin|success|run COMMAND [ARG ...]" >&2
        exit 2
        ;;
esac
