def parse_arguments(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="install the exact local Kilix Ollama/Vulkan runtime closure"
    )
    parser.add_argument(
        "--closure",
        type=Path,
        help="exact verified runtime closure directory",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="describe exact inputs and destinations without changing the system",
    )
    parser.add_argument(
        "--verify",
        action="store_true",
        help="verify the installed runtime, service, and Debian package floors",
    )
    parser.add_argument("--manifest", type=Path, help="selected release manifest for carrier operations")
    parser.add_argument("--verify-carrier", type=Path, help="verify a release-pinned carrier archive")
    parser.add_argument("--extract-carrier", type=Path, help="safely extract a release-pinned carrier archive")
    parser.add_argument("--destination", type=Path, help="private empty directory for --extract-carrier")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_arguments(sys.argv[1:] if argv is None else argv)
    if sum((
        args.closure is not None,
        args.dry_run,
        args.verify,
        args.verify_carrier is not None,
        args.extract_carrier is not None,
    )) != 1:
        print(
            "plebian-os-install-kilix-ollama-runtime: choose exactly one of "
            "--closure PATH, --dry-run, --verify, --verify-carrier PATH, "
            "or --extract-carrier PATH",
            file=sys.stderr,
        )
        return 2
    if args.verify_carrier is not None or args.extract_carrier is not None:
        if args.manifest is None:
            print("plebian-os-install-kilix-ollama-runtime: carrier mode requires --manifest", file=sys.stderr)
            return 2
        if args.verify_carrier is not None and args.destination is not None:
            print("plebian-os-install-kilix-ollama-runtime: --destination requires --extract-carrier", file=sys.stderr)
            return 2
        if args.extract_carrier is not None and args.destination is None:
            print("plebian-os-install-kilix-ollama-runtime: --extract-carrier requires --destination", file=sys.stderr)
            return 2
    elif args.manifest is not None or args.destination is not None:
        print("plebian-os-install-kilix-ollama-runtime: --manifest and --destination are carrier-only options", file=sys.stderr)
        return 2
    if args.dry_run:
        print_plan()
        return 0
    try:
        if args.verify_carrier is not None:
            size, digest = verify_carrier_archive(args.verify_carrier, args.manifest)
            print(f"verified Ollama carrier: {size} bytes, SHA-256 {digest}")
            return 0
        if args.extract_carrier is not None:
            if os.geteuid() != 0:
                fail("carrier extraction must run as root")
            extract_carrier_archive(args.extract_carrier, args.manifest, args.destination)
            print(f"extracted verified Ollama runtime closure to {args.destination}")
            return 0
        if args.verify:
            verify_platform()
            verify_packages()
            verify_generation()
            verify_launcher()
            verify_service_assets()
            print(f"verified {LAUNCHER}")
            return 0
        if os.geteuid() != 0:
            fail("installation must run as root (try sudo)")
        source = args.closure.resolve(strict=True)
        changed = install(source)
        print(("installed" if changed else "already verified"), LAUNCHER)
        return 0
    except (InstallFailure, OSError) as error:
        print(f"plebian-os-install-kilix-ollama-runtime: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
