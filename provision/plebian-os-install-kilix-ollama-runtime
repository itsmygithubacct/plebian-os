def digest_file(
    path: Path,
    *,
    expected_size: int | None = None,
    expected_hash: str | None = None,
    expected_owner: int | None = None,
    expected_mode: int | None = None,
) -> tuple[int, str]:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as error:
        fail(f"cannot open closure file {path}: {error}")
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode):
            fail(f"closure entry is not a regular file: {path}")
        if expected_size is not None and info.st_size != expected_size:
            fail(f"closure entry has an unexpected size: {path}")
        if expected_owner is not None and info.st_uid != expected_owner:
            fail(f"closure entry has an unexpected owner: {path}")
        if expected_mode is not None and stat.S_IMODE(info.st_mode) != expected_mode:
            fail(f"closure entry has an unexpected mode: {path}")
        digest = hashlib.sha256()
        with os.fdopen(descriptor, "rb", closefd=False) as stream:
            for block in iter(lambda: stream.read(1024 * 1024), b""):
                digest.update(block)
        value = digest.hexdigest()
        if expected_hash is not None and value != expected_hash:
            fail(f"closure entry failed SHA-256 verification: {path}")
        return info.st_size, value
    finally:
        os.close(descriptor)


def read_exact_file(path: Path, *, size: int, digest: str) -> bytes:
    digest_file(path, expected_size=size, expected_hash=digest)
    payload = path.read_bytes()
    if len(payload) != size or hashlib.sha256(payload).hexdigest() != digest:
        fail(f"closure entry changed during verification: {path}")
    return payload


def parse_notice_manifest(payload: bytes) -> dict[PurePosixPath, str]:
    try:
        text = payload.decode("utf-8", errors="strict")
    except UnicodeError as error:
        raise InstallFailure("notice manifest is not UTF-8") from error
    records: dict[PurePosixPath, str] = {}
    lines = text.splitlines()
    if len(lines) != NOTICE_RECORDS or not text.endswith("\n"):
        fail("notice manifest has an unexpected record count or terminator")
    for line in lines:
        match = _MANIFEST_LINE.fullmatch(line)
        if match is None:
            fail("notice manifest contains a malformed record")
        relative = PurePosixPath(match.group(2))
        if (
            relative.is_absolute()
            or not relative.parts
            or ".." in relative.parts
            or relative in records
        ):
            fail("notice manifest contains an unsafe or duplicate path")
        records[relative] = match.group(1)
    return records


def closure_inventory(root: Path) -> tuple[set[PurePosixPath], dict[PurePosixPath, str], set[PurePosixPath]]:
    files: set[PurePosixPath] = set()
    links: dict[PurePosixPath, str] = {}
    directories: set[PurePosixPath] = {PurePosixPath(".")}
    for current, directory_names, file_names in os.walk(root, topdown=True, followlinks=False):
        current_path = Path(current)
        relative_root = PurePosixPath(current_path.relative_to(root).as_posix())
        for name in list(directory_names):
            path = current_path / name
            relative = relative_root / name
            info = path.lstat()
            if stat.S_ISLNK(info.st_mode):
                links[relative] = os.readlink(path)
                directory_names.remove(name)
            elif stat.S_ISDIR(info.st_mode):
                directories.add(relative)
            else:
                fail(f"closure directory entry has an unsafe type: {relative}")
        for name in file_names:
            path = current_path / name
            relative = relative_root / name
            info = path.lstat()
            if stat.S_ISLNK(info.st_mode):
                links[relative] = os.readlink(path)
            elif stat.S_ISREG(info.st_mode):
                files.add(relative)
            else:
                fail(f"closure file entry has an unsafe type: {relative}")
    return files, links, directories


def parent_directories(paths: set[PurePosixPath]) -> set[PurePosixPath]:
    directories = {PurePosixPath(".")}
    for path in paths:
        parent = path.parent
        while parent != PurePosixPath("."):
            directories.add(parent)
            parent = parent.parent
    return directories


def verify_source_closure(root: Path) -> dict[PurePosixPath, tuple[int, str, int]]:
    try:
        info = root.lstat()
    except OSError as error:
        fail(f"cannot inspect local runtime closure: {error}")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
        fail("local runtime closure is not a real directory")

    manifest_payload = read_exact_file(
        root.joinpath(*NOTICE_MANIFEST.parts),
        size=NOTICE_MANIFEST_SIZE,
        digest=NOTICE_MANIFEST_SHA256,
    )
    notices = parse_notice_manifest(manifest_payload)
    expected: dict[PurePosixPath, tuple[int, str, int]] = {}
    for relative, (size, digest) in RUNTIME_FILES.items():
        expected[relative] = (size, digest, 0o755)
    expected[BUILD_CLOSURE] = (BUILD_CLOSURE_SIZE, BUILD_CLOSURE_SHA256, 0o644)
    expected[NOTICE_MANIFEST] = (
        NOTICE_MANIFEST_SIZE,
        NOTICE_MANIFEST_SHA256,
        0o644,
    )

    notice_bytes = 0
    for relative, digest in notices.items():
        path = NOTICE_ROOT / relative
        size, actual = digest_file(root.joinpath(*path.parts), expected_hash=digest)
        notice_bytes += size
        if notice_bytes > MAX_NOTICE_BYTES:
            fail("notice closure exceeds its byte bound")
        expected[path] = (size, actual, 0o644)

    files, links, directories = closure_inventory(root)
    if files != set(expected):
        fail("local runtime closure has missing or unexpected regular files")
    if links != RUNTIME_LINKS:
        fail("local runtime closure has missing or unexpected symbolic links")
    wanted_directories = parent_directories(files | set(links))
    if directories != wanted_directories:
        fail("local runtime closure has missing or unexpected directories")

    for relative, (size, digest, _mode) in expected.items():
        digest_file(
            root.joinpath(*relative.parts),
            expected_size=size,
            expected_hash=digest,
        )
    return expected


def write_exclusive(path: Path, payload: bytes, mode: int) -> None:
    descriptor = os.open(
        path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
        mode,
    )
    with os.fdopen(descriptor, "wb") as stream:
        stream.write(payload)
        stream.flush()
        os.fsync(stream.fileno())
    os.chmod(path, mode)


def copy_exact_file(
    source: Path,
    destination: Path,
    *,
    size: int,
    digest: str,
    mode: int,
) -> None:
    source_descriptor = os.open(source, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    destination_descriptor = -1
    try:
        source_info = os.fstat(source_descriptor)
        if not stat.S_ISREG(source_info.st_mode) or source_info.st_size != size:
            fail(f"source closure entry changed: {source}")
        destination_descriptor = os.open(
            destination,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
            mode,
        )
        actual = hashlib.sha256()
        copied = 0
        with os.fdopen(source_descriptor, "rb") as input_stream, os.fdopen(
            destination_descriptor, "wb"
        ) as output_stream:
            source_descriptor = -1
            destination_descriptor = -1
            for block in iter(lambda: input_stream.read(1024 * 1024), b""):
                copied += len(block)
                actual.update(block)
                output_stream.write(block)
            output_stream.flush()
            os.fsync(output_stream.fileno())
        if copied != size or actual.hexdigest() != digest:
            fail(f"source closure entry changed during copy: {source}")
        os.chmod(destination, mode)
    finally:
        if source_descriptor >= 0:
            os.close(source_descriptor)
        if destination_descriptor >= 0:
            os.close(destination_descriptor)


def create_directories(root: Path, paths: set[PurePosixPath]) -> None:
    for relative in sorted(paths, key=lambda item: (len(item.parts), item.parts)):
        if relative == PurePosixPath("."):
            continue
        directory = root.joinpath(*relative.parts)
        directory.mkdir(mode=0o755)
        os.chmod(directory, 0o755)


def verify_generation(path: Path = GENERATION, *, expected_owner: int = 0) -> None:
    try:
        root_info = path.lstat()
    except OSError as error:
        fail(f"installed runtime generation is unavailable: {error}")
    if (
        stat.S_ISLNK(root_info.st_mode)
        or not stat.S_ISDIR(root_info.st_mode)
        or root_info.st_uid != expected_owner
        or stat.S_IMODE(root_info.st_mode) != 0o755
    ):
        fail("installed runtime generation root is unsafe")

    manifest_payload = read_exact_file(
        path.joinpath(*NOTICE_MANIFEST.parts),
        size=NOTICE_MANIFEST_SIZE,
        digest=NOTICE_MANIFEST_SHA256,
    )
    notices = parse_notice_manifest(manifest_payload)
    expected_files = (
        set(RUNTIME_FILES)
        | {BUILD_CLOSURE, NOTICE_MANIFEST}
        | {NOTICE_ROOT / relative for relative in notices}
        | set(GENERATED_FILES)
    )
    files, links, directories = closure_inventory(path)
    if files != expected_files or links != RUNTIME_LINKS:
        fail("installed runtime generation inventory is not exact")
    if directories != parent_directories(files | set(links)):
        fail("installed runtime generation directory inventory is not exact")

    for relative, (size, digest) in RUNTIME_FILES.items():
        digest_file(
            path.joinpath(*relative.parts),
            expected_size=size,
            expected_hash=digest,
            expected_owner=expected_owner,
            expected_mode=0o755,
        )
    digest_file(
        path.joinpath(*BUILD_CLOSURE.parts),
        expected_size=BUILD_CLOSURE_SIZE,
        expected_hash=BUILD_CLOSURE_SHA256,
        expected_owner=expected_owner,
        expected_mode=0o644,
    )
    digest_file(
        path.joinpath(*NOTICE_MANIFEST.parts),
        expected_size=NOTICE_MANIFEST_SIZE,
        expected_hash=NOTICE_MANIFEST_SHA256,
        expected_owner=expected_owner,
        expected_mode=0o644,
    )
    for relative, digest in notices.items():
        digest_file(
            path.joinpath(*(NOTICE_ROOT / relative).parts),
            expected_hash=digest,
            expected_owner=expected_owner,
            expected_mode=0o644,
        )
    for relative, payload in GENERATED_FILES.items():
        digest_file(
            path.joinpath(*relative.parts),
            expected_size=len(payload),
            expected_hash=hashlib.sha256(payload).hexdigest(),
            expected_owner=expected_owner,
            expected_mode=0o644,
        )
    for relative, target in RUNTIME_LINKS.items():
        link = path.joinpath(*relative.parts)
        info = link.lstat()
        if not stat.S_ISLNK(info.st_mode) or info.st_uid != expected_owner:
            fail(f"installed runtime link is unsafe: {relative}")
        if os.readlink(link) != target:
            fail(f"installed runtime link target drifted: {relative}")
    for relative in directories:
        directory = path if relative == PurePosixPath(".") else path.joinpath(*relative.parts)
        info = directory.lstat()
        if (
            stat.S_ISLNK(info.st_mode)
            or not stat.S_ISDIR(info.st_mode)
            or info.st_uid != expected_owner
            or stat.S_IMODE(info.st_mode) != 0o755
        ):
            fail(f"installed runtime directory is unsafe: {relative}")


def verify_launcher(path: Path = LAUNCHER) -> None:
    payload = WRAPPER_SOURCE.encode("utf-8")
    digest_file(
        path,
        expected_size=len(payload),
        expected_hash=hashlib.sha256(payload).hexdigest(),
        expected_owner=0,
        expected_mode=0o755,
    )


def stage_generation(source: Path, work: Path) -> Path:
    expected = verify_source_closure(source)
    stage = work / "generation"
    stage.mkdir(mode=0o755)
    os.chmod(stage, 0o755)
    all_paths = set(expected) | set(RUNTIME_LINKS) | set(GENERATED_FILES)
    create_directories(stage, parent_directories(all_paths))
    for relative, (size, digest, mode) in expected.items():
        copy_exact_file(
            source.joinpath(*relative.parts),
            stage.joinpath(*relative.parts),
            size=size,
            digest=digest,
            mode=mode,
        )
    for relative, target in RUNTIME_LINKS.items():
        os.symlink(target, stage.joinpath(*relative.parts))
    for relative, payload in GENERATED_FILES.items():
        write_exclusive(stage.joinpath(*relative.parts), payload, 0o644)
    verify_generation(stage, expected_owner=os.geteuid())
    return stage


def publish_generation(staged: Path) -> None:
    destination_stage = Path(
        tempfile.mkdtemp(prefix=f".{GENERATION_NAME}.stage-", dir=INSTALL_ROOT)
    )
    try:
        destination_stage.rmdir()
        shutil.copytree(staged, destination_stage, symlinks=True)
        verify_generation(destination_stage, expected_owner=0)
        os.rename(destination_stage, GENERATION)
        fsync_directory(INSTALL_ROOT)
    finally:
        if os.path.lexists(destination_stage):
            shutil.rmtree(destination_stage)


def publish_launcher() -> None:
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=".ollama-wrapper-", dir=INSTALL_ROOT
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(WRAPPER_SOURCE.encode("utf-8"))
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o755)
        os.rename(temporary, LAUNCHER)
        fsync_directory(INSTALL_ROOT)
    finally:
        temporary.unlink(missing_ok=True)


def install(source: Path) -> bool:
    verify_platform()
    verify_packages()
    ensure_root_path(SESSION_ROOT, final_mode=0o700)
    ensure_root_path(INSTALL_ROOT, final_mode=0o755)
    if shutil.disk_usage(SESSION_ROOT).free < MINIMUM_FREE_BYTES:
        fail("at least 256 MiB free is required to stage the local runtime closure")

    generation_exists = os.path.lexists(GENERATION)
    launcher_exists = os.path.lexists(LAUNCHER)
    if generation_exists:
        verify_generation()
    if launcher_exists:
        verify_launcher()
    if generation_exists and launcher_exists:
        return False
    if launcher_exists and not generation_exists:
        fail("runtime launcher exists without its generation; refusing to replace it")

    work = Path(tempfile.mkdtemp(prefix="kilix-ollama-runtime.", dir=SESSION_ROOT))
    os.chmod(work, 0o700)
    try:
        if not generation_exists:
            staged = stage_generation(source, work)
            publish_generation(staged)
            verify_generation()
        publish_launcher()
        verify_launcher()
        return True
    finally:
        shutil.rmtree(work)


def print_plan() -> None:
    print("Kilix Ollama private-Unix Vulkan runtime (optional; no models or weights)")
    print(f"  carrier: {CARRIER_STATUS}; an exact local closure is required")
    print("  upstream Ollama: 0.32.14 @ d67ad83426633195089509347ffd4fe795120198")
    print("  upstream llama.cpp: 7e4c0a96880dae4fc4268ad441f8a6446bd5460a")
    print(f"  Unix listener patch sha256: {UNIX_LISTENER_PATCH_SHA256}")
    print(f"  runtime files: {len(RUNTIME_FILES)}")
    print(f"  runtime bytes: {sum(size for size, _digest in RUNTIME_FILES.values())}")
    print(f"  generation: {GENERATION}")
    print(f"  launcher: {LAUNCHER}")
    print("  Debian direct pins:")
    for package, version in PACKAGE_VERSIONS.items():
        print(f"    {package}={version}")


def parse_arguments(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="install the exact local Kilix Ollama/Vulkan runtime closure"
    )
    parser.add_argument(
        "--closure",
        type=Path,
        help="exact locally supplied runtime directory (no carrier is accepted yet)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="describe exact inputs and destinations without changing the system",
    )
    parser.add_argument(
        "--verify",
        action="store_true",
        help="verify the installed runtime and exact Debian runtime pins",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_arguments(sys.argv[1:] if argv is None else argv)
    if sum((args.closure is not None, args.dry_run, args.verify)) != 1:
        print(
            "plebian-os-install-kilix-ollama-runtime: choose exactly one of "
            "--closure PATH, --dry-run, or --verify",
            file=sys.stderr,
        )
        return 2
    if args.dry_run:
        print_plan()
        return 0
    try:
        if args.verify:
            verify_platform()
            verify_packages()
            verify_generation()
            verify_launcher()
            print(f"verified {LAUNCHER}")
            return 0
        if os.geteuid() != 0:
            fail("installation must run as root (try sudo)")
        source = args.closure.resolve(strict=True)
        changed = install(source)
        print(("installed" if changed else "already verified"), LAUNCHER)
        return 0
    except (InstallFailure, OSError) as error:
        print(f"plebian-os-install-kilix-ollama-runtime: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
