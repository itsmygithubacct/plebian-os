# plebian-os-firstboot.service — finish Plebian-OS on the first boot after a
# regular Debian install. The installer has already installed pleb and kilix
# from the disc. This unit brings up the Pleb session and does not clone them.
# Installed + enabled by the preseed's late_command (or by bootstrap.sh).
# Runs once, then disables itself.
[Unit]
Description=Plebian-OS first-boot provisioning (packaged pleb and kilix, Pleb session)
Documentation=https://github.com/itsmygithubacct/plebian-os
# Needs the network for payloads that are not packages, and a settled base system.
After=network-online.target systemd-user-sessions.service
# The target pulls in firstboot. Let it finish before dpkg starts services
# ordered after multi-user.target, including power-profiles-daemon.
After=multi-user.target
Wants=network-online.target
# Hold the login greeter until provisioning finishes, so the very first boot
# never flashes a bare "Default Xsession" (Pleb isn't installed yet) at the
# user — they'd log into that, hit the fallback, and think it's broken. This is
# ORDERING ONLY (not Requires): if provisioning fails or times out, the greeter
# still comes up rather than the boot deadlocking. On every later boot the
# Condition below skips this unit (and it has disabled itself), so the ordering
# is a no-op and normal boots are never delayed.
Before=display-manager.service
# The daily apt and unattended-upgrades jobs wait the same way, so a background
# upgrade never contends with provisioning for the dpkg lock. Also ordering only.
Before=apt-daily.service apt-daily-upgrade.service
# Don't run if provisioning already completed.
ConditionPathExists=!/var/lib/plebian-os/provisioned
# First boot depends on the network for payloads that are not packages. The attempt runner keeps
# this one start job activating across up to three attempts. An attempt is
# stopped only after 20 minutes without progress (no output and no I/O by any
# of its processes), so a slow but progressing link is not cut off, and all
# attempts share one five-hour ceiling. Keeping one continuous start job
# matters: Before=display-manager.service then holds LightDM until either
# provisioning succeeds or every retry (or the ceiling) is exhausted, so a stop
# cannot expose and cache Debian's fallback session between attempts.

[Service]
Type=oneshot
RemainAfterExit=yes
# Optional build-time provisioning options. The provisioner honours
# PLEBIAN_OS_DESKTOP / PLEBIAN_OS_KIOSK; an automated preseed may also set
# PLEBIAN_OS_USER. Normal media resolves the account from the root-owned Debian
# Installer record instead. The leading '-' makes this file optional.
EnvironmentFile=-/etc/default/plebian-os
# Media with a ready offline desktop defers this job until its Debian archive
# is reachable, without consuming an attempt or delaying the graphical login.
# A persistent counter makes the three-attempt bound survive reboots. When it
# is exhausted ExecCondition skips the unit without marking success; the display
# manager can start, and an operator can inspect the journal/fix the network.
ExecCondition=/usr/sbin/plebian-os-firstboot-attempt check
# Clear any temporary sudoers grant a previously killed attempt may have left
# behind (SIGKILL can't run the provisioner's own cleanup trap).
ExecStartPre=-/bin/rm -f /etc/sudoers.d/plebian-os-provision
ExecStart=/usr/sbin/plebian-os-firstboot-attempt run /usr/sbin/plebian-os-provision
# Defense in depth: cleanup runs after success, ordinary failure, timeout, and
# signal-driven stops even if the shell's own EXIT/signal trap is bypassed.
ExecStopPost=-/bin/rm -f /etc/sudoers.d/plebian-os-provision
# Mark done and stop pulling on every boot (success only).
ExecStartPost=/usr/bin/install -Dm644 /dev/null /var/lib/plebian-os/provisioned
ExecStartPost=/usr/sbin/plebian-os-firstboot-attempt success
ExecStartPost=/bin/systemctl disable plebian-os-firstboot.service
# The runner's five-hour ceiling covers every attempt, recovery and retry
# delay. A stop at the ceiling then waits up to 10 minutes for a running dpkg,
# gives the provisioner 15 minutes to roll back, and waits up to 10 minutes for
# dpkg again before SIGKILL: 5h35m in all. This outer timeout is only a final
# guard on the complete, continuously ordered job, so it sits beyond that.
TimeoutStartSec=5h45min
# A stop goes to the runner alone (not to dpkg, apt or the log tee directly);
# the runner waits for any running dpkg before it signals the attempt and then
# lets its rollback finish. SIGKILL of everything left is the final bound, after
# the same 35-minute stop sequence.
KillMode=mixed
TimeoutStopSec=40min
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
