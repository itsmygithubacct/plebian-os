        const uint32_t status = synthesize(
            params,
            model,
            mctx.get(),
            prompt,
            &output);
        if (!send_response(
                status,
                output.empty() ? nullptr : output.data(),
                status == 0 ? static_cast<uint64_t>(output.size()) : 0)) {
            llama_backend_free();
            return 8;
        }
        if (status != 0) {
            llama_backend_free();
            return 9;
        }
    }

    llama_backend_free();
    return 0;
}
