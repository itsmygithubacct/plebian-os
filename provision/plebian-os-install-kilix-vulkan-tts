            "30",
            "--max-time",
            "600",
            "--silent",
            "--show-error",
            "--output",
            str(destination),
            ARCHIVE_URL,
        ],
        stdin=subprocess.DEVNULL,
        env={
            "HOME": str(private_home),
            "PATH": "/usr/bin:/bin",
            "LANG": "C",
            "LC_ALL": "C",
        },
        check=False,
    )
    if result.returncode != 0:
        fail(f"source archive download failed with status {result.returncode}")
    try:
        info = destination.lstat()
    except OSError as error:
        fail(f"downloaded archive is unavailable: {error}")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        fail("downloaded archive is not a regular file")
    if info.st_size != ARCHIVE_SIZE or sha256(destination) != ARCHIVE_SHA256:
        fail("downloaded archive failed its exact size/SHA-256 pin")
    os.chmod(destination, 0o600)


def archive_member_path(member_name: str) -> PurePosixPath:
    member = PurePosixPath(member_name)
    if member.is_absolute() or ".." in member.parts or not member.parts:
        fail(f"unsafe archive member: {member_name}")
    if member.parts[0] != ARCHIVE_ROOT:
        fail(f"archive member has an unexpected root: {member_name}")
    return PurePosixPath(*member.parts[1:])


def write_exclusive(path: Path, data: bytes, mode: int) -> None:
    descriptor = os.open(
        path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
        mode,
    )
    with os.fdopen(descriptor, "wb") as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())
    os.chmod(path, mode)


def ensure_private_directory(root: Path, relative: PurePosixPath) -> Path:
    current = root
    for part in relative.parts:
        current /= part
        try:
            info = current.lstat()
        except FileNotFoundError:
            current.mkdir(mode=0o700)
            continue
        except OSError as error:
            fail(f"cannot inspect extraction directory {current}: {error}")
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
            fail(f"source archive path is not a directory: {current}")
    return current


def extract_source(archive: Path, target: Path) -> None:
    target.mkdir(mode=0o700)
    seen: set[PurePosixPath] = set()
    total = 0
    members = 0
    with tarfile.open(archive, mode="r:gz") as source:
        for member in source:
            members += 1
            if members > MAX_ARCHIVE_MEMBERS:
                fail("source archive exceeds its member-count bound")
            relative = archive_member_path(member.name)
            if relative in seen:
                fail(f"duplicate source archive member: {relative}")
            seen.add(relative)
            if not relative.parts:
                if not member.isdir():
                    fail("source archive root is not a directory")
                continue
            destination = target.joinpath(*relative.parts)
            if member.isdir():
                ensure_private_directory(target, relative)
                continue
            if not member.isfile() or member.size < 0:
                fail(f"source archive member is not a regular file: {relative}")
            total += member.size
            if total > MAX_EXTRACTED_BYTES:
                fail("source archive exceeds its extracted-byte bound")
            ensure_private_directory(target, relative.parent)
            input_stream = source.extractfile(member)
            if input_stream is None:
                fail(f"cannot read source archive member: {relative}")
            mode = 0o700 if member.mode & 0o111 else 0o600
            descriptor = os.open(
                destination,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
                mode,
            )
            copied = 0
            with input_stream, os.fdopen(descriptor, "wb") as output:
                while True:
                    block = input_stream.read(1024 * 1024)
                    if not block:
                        break
                    copied += len(block)
                    output.write(block)
            if copied != member.size:
                fail(f"short extraction for source archive member: {relative}")
    if members != ARCHIVE_MEMBERS or total != ARCHIVE_EXTRACTED_BYTES:
        fail("source archive contents do not match the pinned member/byte counts")
    license_path = target / "LICENSE"
    if sha256(license_path) != (
        "94f29bbed6a22c35b992c5c6ebf0e7c92f13b836b90f36f461c9cf2f0f1d010d"
    ):
        fail("extracted llama.cpp license failed verification")


