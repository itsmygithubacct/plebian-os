def run_checked(arguments: list[str], *, cwd: Path, env: dict[str, str]) -> None:
    result = subprocess.run(
        arguments,
        cwd=cwd,
        env=env,
        stdin=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode != 0:
        fail(f"local runtime build command failed with status {result.returncode}")


def build_runtime(work: Path) -> Path:
    worker_dir = work / "worker"
    worker_dir.mkdir(mode=0o700)
    worker_bytes = WORKER_SOURCE.encode("utf-8")
    if hashlib.sha256(worker_bytes).hexdigest() != WORKER_SOURCE_SHA256:
        fail("embedded Kilix worker source failed its own SHA-256 pin")
    write_exclusive(worker_dir / "kilix_tts_worker.cpp", worker_bytes, 0o600)
    build = work / "build"
    build.mkdir(mode=0o700)
    env = build_environment(work)
    run_checked(cmake_arguments(work), cwd=work, env=env)
    run_checked(
        [
            "/usr/bin/cmake",
            "--build",
            str(build),
            "--target",
            "llama-tts",
            "--parallel",
            "2",
        ],
        cwd=work,
        env=env,
    )
    run_checked(compiler_arguments(work), cwd=work, env=env)
    return build / "bin"


def verified_file_digest(
    path: Path,
    *,
    expected_size: int,
    expected_hash: str,
    expected_owner: int,
    expected_mode: int,
) -> None:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as error:
        fail(f"cannot open runtime closure file {path}: {error}")
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode):
            fail(f"runtime closure entry is not a regular file: {path}")
        if info.st_uid != expected_owner or stat.S_IMODE(info.st_mode) != expected_mode:
            fail(f"runtime closure entry has unsafe ownership/mode: {path}")
        if info.st_size != expected_size:
            fail(f"runtime closure entry has an unexpected size: {path}")
        digest = hashlib.sha256()
        with os.fdopen(descriptor, "rb", closefd=False) as stream:
            for block in iter(lambda: stream.read(1024 * 1024), b""):
                digest.update(block)
        if digest.hexdigest() != expected_hash:
            fail(f"runtime closure entry failed SHA-256 verification: {path}")
    finally:
        os.close(descriptor)


def copy_verified_output(source: Path, destination: Path, size: int, digest: str) -> None:
    try:
        source_descriptor = os.open(
            source, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
        )
    except OSError as error:
        fail(f"cannot open local build output {source}: {error}")
    destination_descriptor = -1
    try:
        info = os.fstat(source_descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_size != size:
            fail(f"local build output has an unexpected type or size: {source.name}")
        destination_descriptor = os.open(
            destination,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
            0o700,
        )
        actual = hashlib.sha256()
        copied = 0
        with os.fdopen(source_descriptor, "rb") as input_stream, os.fdopen(
            destination_descriptor, "wb"
        ) as output_stream:
            source_descriptor = -1
            destination_descriptor = -1
            for block in iter(lambda: input_stream.read(1024 * 1024), b""):
                copied += len(block)
                actual.update(block)
                output_stream.write(block)
            output_stream.flush()
            os.fsync(output_stream.fileno())
        if copied != size or actual.hexdigest() != digest:
            destination.unlink(missing_ok=True)
            fail(f"local build output failed its exact pin: {source.name}")
        os.chmod(destination, 0o755)
    finally:
        if source_descriptor >= 0:
            os.close(source_descriptor)
        if destination_descriptor >= 0:
            os.close(destination_descriptor)


def generation_texts() -> dict[str, bytes]:
    return {
        "BUILD-CLOSURE": build_closure_text().encode("utf-8"),
        "LICENSE.kilix": KILIX_LICENSE.encode("utf-8"),
        "NOTICE": NOTICE.encode("utf-8"),
    }


def verify_generation(path: Path = GENERATION, *, expected_owner: int = 0) -> None:
    try:
        info = path.lstat()
    except OSError as error:
        fail(f"cannot inspect runtime generation: {error}")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
        fail("runtime generation is not a real directory")
    if info.st_uid != expected_owner or stat.S_IMODE(info.st_mode) != 0o755:
        fail("runtime generation has unsafe ownership/mode")
    expected_names = set(RUNTIME_OUTPUTS) | set(generation_texts()) | {
        "LICENSE.llama.cpp"
    }
    if {entry.name for entry in os.scandir(path)} != expected_names:
        fail("runtime generation has unexpected entries")
    for name, (_build_name, size, digest) in RUNTIME_OUTPUTS.items():
        verified_file_digest(
            path / name,
            expected_size=size,
            expected_hash=digest,
            expected_owner=expected_owner,
            expected_mode=0o755,
        )
    for name, expected in generation_texts().items():
        verified_file_digest(
            path / name,
            expected_size=len(expected),
            expected_hash=hashlib.sha256(expected).hexdigest(),
            expected_owner=expected_owner,
            expected_mode=0o644,
        )
    verified_file_digest(
        path / "LICENSE.llama.cpp",
        expected_size=1_078,
        expected_hash=(
            "94f29bbed6a22c35b992c5c6ebf0e7c"
            "92f13b836b90f36f461c9cf2f0f1d010d"
        ),
        expected_owner=expected_owner,
        expected_mode=0o644,
    )


def verify_wrapper(path: Path = WORKER_PATH) -> None:
    expected = WRAPPER_SOURCE.encode("utf-8")
    verified_file_digest(
        path,
        expected_size=len(expected),
        expected_hash=hashlib.sha256(expected).hexdigest(),
        expected_owner=0,
        expected_mode=0o755,
    )


def stage_generation(work: Path, build_bin: Path) -> Path:
    stage = work / "generation"
    stage.mkdir(mode=0o700)
    for final_name, (build_name, size, digest) in RUNTIME_OUTPUTS.items():
        copy_verified_output(build_bin / build_name, stage / final_name, size, digest)
    for name, payload in generation_texts().items():
        write_exclusive(stage / name, payload, 0o644)
    llama_license = work / "source/LICENSE"
    copy_verified_output(
        llama_license,
        stage / "LICENSE.llama.cpp",
        1_078,
        "94f29bbed6a22c35b992c5c6ebf0e7c92f13b836b90f36f461c9cf2f0f1d010d",
    )
    os.chmod(stage / "LICENSE.llama.cpp", 0o644)
    os.chmod(stage, 0o755)
    verify_generation(stage, expected_owner=os.geteuid())
    return stage


def publish_generation(staged: Path) -> None:
    destination_stage = Path(
        tempfile.mkdtemp(prefix=f".{GENERATION_NAME}.stage-", dir=INSTALL_ROOT)
    )
    try:
        destination_stage.rmdir()
        shutil.copytree(staged, destination_stage, symlinks=False)
        os.chmod(destination_stage, 0o755)
        for entry in os.scandir(destination_stage):
            os.chmod(
                entry.path,
                0o755 if entry.name in RUNTIME_OUTPUTS else 0o644,
            )
        verify_generation(destination_stage, expected_owner=0)
        os.rename(destination_stage, GENERATION)
        fsync_directory(INSTALL_ROOT)
    finally:
        if os.path.lexists(destination_stage):
            shutil.rmtree(destination_stage)


def publish_wrapper() -> None:
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=".kilix-tts-wrapper-", dir=INSTALL_ROOT
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(WRAPPER_SOURCE.encode("utf-8"))
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o755)
        os.rename(temporary, WORKER_PATH)
        fsync_directory(INSTALL_ROOT)
    finally:
        temporary.unlink(missing_ok=True)


def install(archive: Path | None) -> bool:
    verify_platform()
    verify_packages()
    ensure_root_path(SESSION_ROOT, final_mode=0o700)
    ensure_root_path(INSTALL_ROOT, final_mode=0o755)
    if shutil.disk_usage(SESSION_ROOT).free < MINIMUM_FREE_BYTES:
        fail("at least 1 GiB free is required for the local Vulkan build")

    generation_exists = os.path.lexists(GENERATION)
    wrapper_exists = os.path.lexists(WORKER_PATH)
    if generation_exists:
        verify_generation()
    if wrapper_exists:
        verify_wrapper()
    if generation_exists and wrapper_exists:
        return False
    if wrapper_exists and not generation_exists:
        fail("runtime wrapper exists without its generation; refusing to replace it")

    work = Path(tempfile.mkdtemp(prefix="kilix-vulkan-tts.", dir=SESSION_ROOT))
    os.chmod(work, 0o700)
    try:
        if not generation_exists:
            archive_stage = work / "llama.cpp.tar.gz"
            if archive is None:
                download_archive(archive_stage, work)
            else:
                copy_and_verify_archive(archive, archive_stage)
            extract_source(archive_stage, work / "source")
            build_bin = build_runtime(work)
            staged = stage_generation(work, build_bin)
            publish_generation(staged)
            verify_generation()
        publish_wrapper()
        verify_wrapper()
        return True
    finally:
        shutil.rmtree(work)


def parse_arguments(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="build the optional persistent Kilix Vulkan TTS runtime"
    )
    parser.add_argument(
        "--archive",
        type=Path,
        help="use an already downloaded exact source archive instead of the network",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="describe exact inputs and destinations without changing the system",
    )
    parser.add_argument(
        "--verify",
        action="store_true",
        help="verify the installed runtime and direct Debian package pins",
    )
    return parser.parse_args(argv)


def print_plan() -> None:
    print("Kilix persistent Vulkan TTS runtime (optional; no model weights)")
    print(f"  source: {ARCHIVE_URL}")
    print(f"  source bytes: {ARCHIVE_SIZE}")
    print(f"  source sha256: {ARCHIVE_SHA256}")
    print(f"  worker source sha256: {WORKER_SOURCE_SHA256}")
    print(f"  temporary free space: at least {MINIMUM_FREE_BYTES} bytes")
    print(f"  installed runtime bytes: {sum(item[1] for item in RUNTIME_OUTPUTS.values())}")
    print("  local build: two jobs; may take several minutes")
    print(f"  generation: {GENERATION}")
    print(f"  launcher: {WORKER_PATH}")
    print("  Debian direct pins:")
    for package, version in PACKAGE_VERSIONS.items():
        print(f"    {package}={version}")


def main(argv: list[str] | None = None) -> int:
    args = parse_arguments(sys.argv[1:] if argv is None else argv)
    if args.dry_run:
        print_plan()
        return 0
    try:
        if args.verify:
            verify_platform()
            verify_packages()
            verify_generation()
            verify_wrapper()
            print(f"verified {WORKER_PATH}")
            return 0
        if os.geteuid() != 0:
            fail("installation must run as root (try sudo)")
        archive = args.archive.resolve(strict=True) if args.archive else None
        changed = install(archive)
        print(("installed" if changed else "already verified"), WORKER_PATH)
        return 0
    except (InstallFailure, OSError, tarfile.TarError) as error:
        print(f"plebian-os-install-kilix-vulkan-tts: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
