    args = sys.argv[1:]
    if len(args) not in (5, 6):
        die("expected SOURCE --outtype q8_0 --outfile OUTPUT [--mmproj]")
    mmproj = len(args) == 6
    if args[1:5:2] != ["--outtype", "--outfile"]:
        die("converter options must use the fixed Pocket argument order")
    if args[2] != "q8_0" or (mmproj and args[5] != "--mmproj"):
        die("only Pocket Q8_0 main and projector conversion is admitted")

    source = Path(args[0])
    output = Path(args[4])
    if not source.is_absolute() or not output.is_absolute():
        die("source and output paths must be absolute")
    try:
        if source.resolve(strict=True) != source:
            die("source path must be canonical and symlink-free")
        if output.parent.resolve(strict=True) != output.parent:
            die("output directory must be canonical and symlink-free")
