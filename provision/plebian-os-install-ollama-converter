class InstallFailure(RuntimeError):
    """A safe, actionable refusal from the closure installer."""


def fail(message: str) -> None:
    raise InstallFailure(message)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def require_root_directory(path: Path, *, private: bool = False) -> None:
    try:
        info = path.lstat()
    except OSError as error:
        fail(f"cannot inspect {path}: {error}")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
        fail(f"not a real directory: {path}")
    mode = stat.S_IMODE(info.st_mode)
    if info.st_uid != 0 or mode & 0o022:
        fail(f"directory is not root-controlled: {path}")
    if private and mode & 0o077:
        fail(f"privileged staging directory is not private: {path}")


def ensure_root_path(path: Path, *, final_mode: int) -> None:
    current = Path("/")
    require_root_directory(current)
    for part in path.parts[1:]:
        current = current / part
        if not os.path.lexists(current):
            os.mkdir(current, final_mode if current == path else 0o755)
        require_root_directory(current, private=current == path and final_mode == 0o700)
    if stat.S_IMODE(path.stat().st_mode) != final_mode:
        os.chmod(path, final_mode)
        require_root_directory(path, private=final_mode == 0o700)


def verify_packages() -> None:
    for package, expected in PACKAGE_VERSIONS.items():
        result = subprocess.run(
            ["/usr/bin/dpkg-query", "-W", "-f=${Version}", package],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            env={"PATH": "/usr/bin:/bin", "LANG": "C", "LC_ALL": "C"},
            check=False,
        )
        if result.returncode != 0 or result.stdout != expected:
            fail(
                f"{package} must be exactly {expected}; first run "
                "plebian-os-install-deps --vulkan-tts"
            )


def copy_and_verify_archive(source: Path, destination: Path) -> None:
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
    try:
        source_descriptor = os.open(source, flags)
    except OSError as error:
        fail(f"cannot open local archive {source}: {error}")
    destination_descriptor = -1
    try:
        info = os.fstat(source_descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_size != ARCHIVE_SIZE:
            fail("local archive is not the exact pinned regular file")
        destination_descriptor = os.open(
            destination,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
            0o600,
        )
        digest = hashlib.sha256()
        count = 0
        with os.fdopen(source_descriptor, "rb") as input_stream, os.fdopen(
            destination_descriptor, "wb"
        ) as output_stream:
            source_descriptor = -1
            destination_descriptor = -1
            for block in iter(lambda: input_stream.read(1024 * 1024), b""):
                count += len(block)
                digest.update(block)
                output_stream.write(block)
            output_stream.flush()
            os.fsync(output_stream.fileno())
        if count != ARCHIVE_SIZE or digest.hexdigest() != ARCHIVE_SHA256:
            destination.unlink(missing_ok=True)
            fail("local archive failed its exact size/SHA-256 pin")
    finally:
        if source_descriptor >= 0:
            os.close(source_descriptor)
        if destination_descriptor >= 0:
            os.close(destination_descriptor)


def download_archive(destination: Path, private_home: Path) -> None:
    result = subprocess.run(
        [
            "/usr/bin/curl",
            "--fail",
            "--location",
            "--proto",
            "=https",
            "--proto-redir",
            "=https",
            "--connect-timeout",
            "30",
            "--max-time",
            "600",
            "--silent",
            "--show-error",
            "--output",
            str(destination),
            ARCHIVE_URL,
        ],
        stdin=subprocess.DEVNULL,
        env={
            "HOME": str(private_home),
            "PATH": "/usr/bin:/bin",
            "LANG": "C",
            "LC_ALL": "C",
            "NO_PROXY": "*",
            "no_proxy": "*",
        },
        check=False,
    )
    if result.returncode != 0:
        fail(f"source archive download failed with status {result.returncode}")
    try:
        info = destination.lstat()
    except OSError as error:
        fail(f"downloaded archive is unavailable: {error}")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        fail("downloaded archive is not a regular file")
    if info.st_size != ARCHIVE_SIZE or sha256(destination) != ARCHIVE_SHA256:
        fail("downloaded archive failed its exact size/SHA-256 pin")
    os.chmod(destination, 0o600)


def selected_member_path(member_name: str) -> PurePosixPath | None:
    member = PurePosixPath(member_name)
    if member.is_absolute() or ".." in member.parts or not member.parts:
        fail(f"unsafe archive member: {member_name}")
    if member.parts[0] != ARCHIVE_ROOT:
        return None
    relative = PurePosixPath(*member.parts[1:])
    if relative in (PurePosixPath("LICENSE"), PurePosixPath("convert_hf_to_gguf.py")):
        return relative
    if relative.parts and relative.parts[0] in ("conversion", "gguf-py"):
        return relative
    return None


def write_exclusive(path: Path, data: bytes, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    descriptor = os.open(
        path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
        mode,
    )
    with os.fdopen(descriptor, "wb") as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())


def extract_selected_tree(archive: Path, target: Path) -> None:
    extracted: set[PurePosixPath] = set()
    total = 0
    with tarfile.open(archive, mode="r:gz") as source:
        for member in source:
            relative = selected_member_path(member.name)
            if relative is None or member.isdir():
                continue
            if relative in extracted:
                fail(f"duplicate selected archive member: {relative}")
            if not member.isfile() or member.size < 0:
                fail(f"selected archive member is not a regular file: {relative}")
            total += member.size
            if total > MAX_EXTRACTED_BYTES:
                fail("selected archive content exceeds its extraction bound")
            stream = source.extractfile(member)
            if stream is None:
                fail(f"cannot read selected archive member: {relative}")
            destination = target.joinpath(*relative.parts)
            destination.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
            descriptor = os.open(
                destination,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
                0o644,
            )
            with stream, os.fdopen(descriptor, "wb") as output:
                shutil.copyfileobj(stream, output, length=1024 * 1024)
            extracted.add(relative)
    required = {PurePosixPath("LICENSE"), PurePosixPath("convert_hf_to_gguf.py")}
    if not required.issubset(extracted):
        fail("source archive is missing required converter files")


def selected_tree_records(
    root: Path, *, expected_owner: int | None = None
) -> tuple[int, str]:
    paths = [root / "LICENSE", root / "convert_hf_to_gguf.py"]
    for name in ("conversion", "gguf-py", "transformers"):
        selected_root = root / name
        root_info = selected_root.lstat()
        if stat.S_ISLNK(root_info.st_mode) or not stat.S_ISDIR(root_info.st_mode):
            fail(f"selected source directory is missing or unsafe: {name}")
        if expected_owner is not None and (
            root_info.st_uid != expected_owner
            or stat.S_IMODE(root_info.st_mode) & 0o022
        ):
            fail(f"selected source directory is not root-controlled: {selected_root}")
        for directory, dirnames, filenames in os.walk(selected_root, followlinks=False):
            dirnames.sort()
            filenames.sort()
            for item in dirnames:
                candidate = Path(directory) / item
                info = candidate.lstat()
                if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
                    fail(f"unsafe selected source directory: {candidate}")
                if expected_owner is not None and (
                    info.st_uid != expected_owner
                    or stat.S_IMODE(info.st_mode) & 0o022
                ):
                    fail(f"selected source directory is not root-controlled: {candidate}")
            paths.extend(Path(directory) / item for item in filenames)
    records = bytearray()
    for path in sorted(paths, key=lambda item: item.relative_to(root).as_posix()):
        info = path.lstat()
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
            fail(f"unsafe selected source file: {path}")
        if expected_owner is not None and (
            info.st_uid != expected_owner or stat.S_IMODE(info.st_mode) & 0o022
        ):
            fail(f"selected source file is not root-controlled: {path}")
        relative = path.relative_to(root).as_posix()
        records.extend(relative.encode("utf-8"))
        records.extend(b"\0")
        records.extend(sha256(path).encode("ascii"))
        records.extend(b"\n")
    return len(paths), hashlib.sha256(records).hexdigest()


def verify_generation(path: Path = GENERATION) -> None:
    require_root_directory(path)
    expected_top = {
        "LICENSE",
        "NOTICE",
        "convert_hf_to_gguf.py",
        "conversion",
        "gguf-py",
        "runner.py",
        "transformers",
    }
    if {entry.name for entry in os.scandir(path)} != expected_top:
        fail("installed converter generation has unexpected entries")
    runner = path / "runner.py"
    notice = path / "NOTICE"
    for target, expected in (
        (runner, RUNNER_SOURCE.encode("utf-8")),
        (notice, NOTICE_SOURCE.encode("utf-8")),
    ):
        info = target.lstat()
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
            fail(f"installed closure file is unsafe: {target}")
        if info.st_uid != 0 or stat.S_IMODE(info.st_mode) & 0o022:
            fail(f"installed closure file is not root-controlled: {target}")
        if target.read_bytes() != expected:
            fail(f"installed closure file has changed: {target}")
    count, digest = selected_tree_records(path, expected_owner=0)
    if count != CONVERTER_TREE_FILES or digest != CONVERTER_TREE_SHA256:
        fail("installed converter source tree failed its aggregate pin")


def verify_wrapper(path: Path = CONVERTER_PATH) -> None:
    info = path.lstat()
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        fail(f"installed converter wrapper is unsafe: {path}")
    if info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o755:
        fail(f"installed converter wrapper has unsafe ownership/mode: {path}")
    if path.read_bytes() != WRAPPER_SOURCE.encode("utf-8"):
        fail("installed converter wrapper has changed")


def publish_generation(staged: Path) -> None:
    destination_stage = Path(
        tempfile.mkdtemp(prefix=f".{GENERATION_NAME}.stage-", dir=INSTALL_ROOT)
    )
    try:
        shutil.rmtree(destination_stage)
        shutil.copytree(staged, destination_stage, symlinks=False)
        for directory, dirnames, filenames in os.walk(destination_stage):
            os.chmod(directory, 0o755)
            for name in dirnames:
                os.chmod(Path(directory) / name, 0o755)
            for name in filenames:
                os.chmod(Path(directory) / name, 0o644)
        verify_staged_count, verify_staged_digest = selected_tree_records(
            destination_stage, expected_owner=0
        )
        if (
            verify_staged_count != CONVERTER_TREE_FILES
            or verify_staged_digest != CONVERTER_TREE_SHA256
        ):
            fail("destination-side converter stage failed verification")
        os.rename(destination_stage, GENERATION)
        fsync_directory(INSTALL_ROOT)
    finally:
        if os.path.lexists(destination_stage):
            shutil.rmtree(destination_stage)


def publish_wrapper() -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=".pocket-wrapper-", dir=INSTALL_ROOT)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(WRAPPER_SOURCE.encode("utf-8"))
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o755)
        os.rename(temporary, CONVERTER_PATH)
        fsync_directory(INSTALL_ROOT)
    finally:
        temporary.unlink(missing_ok=True)


def install(archive: Path | None) -> bool:
    verify_packages()
    ensure_root_path(SESSION_ROOT, final_mode=0o700)
    ensure_root_path(INSTALL_ROOT, final_mode=0o755)

    generation_exists = os.path.lexists(GENERATION)
    wrapper_exists = os.path.lexists(CONVERTER_PATH)
    if generation_exists:
        verify_generation()
    if wrapper_exists:
        verify_wrapper()
    if generation_exists and wrapper_exists:
        return False
    if wrapper_exists and not generation_exists:
        fail("converter wrapper exists without its generation; refusing to replace it")

    work = Path(tempfile.mkdtemp(prefix="pocket-converter.", dir=SESSION_ROOT))
    os.chmod(work, 0o700)
    try:
        if not generation_exists:
            archive_stage = work / "llama.cpp.tar.gz"
            if archive is None:
                download_archive(archive_stage, work)
            else:
                copy_and_verify_archive(archive, archive_stage)
            source_stage = work / GENERATION_NAME
            source_stage.mkdir(mode=0o700)
            extract_selected_tree(archive_stage, source_stage)
            (source_stage / "transformers").mkdir(mode=0o755)
            write_exclusive(
                source_stage / "transformers" / "__init__.py",
                STUB_SOURCE.encode("utf-8"),
            )
            write_exclusive(source_stage / "runner.py", RUNNER_SOURCE.encode("utf-8"))
            write_exclusive(source_stage / "NOTICE", NOTICE_SOURCE.encode("utf-8"))
            count, digest = selected_tree_records(source_stage)
            if count != CONVERTER_TREE_FILES or digest != CONVERTER_TREE_SHA256:
                fail("selected converter tree failed its aggregate pin")
            publish_generation(source_stage)
            verify_generation()
        publish_wrapper()
        verify_wrapper()
        return True
    finally:
        shutil.rmtree(work)


def parse_arguments(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="install the optional Pocket-only llama.cpp converter closure"
    )
    parser.add_argument(
        "--archive",
        type=Path,
        help="use an already downloaded exact source archive instead of the network",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="describe exact inputs and destinations without changing the system",
    )
    parser.add_argument(
        "--verify",
        action="store_true",
        help="verify the installed converter and direct Debian package pins",
    )
    return parser.parse_args(argv)


def print_plan() -> None:
    print("Pocket TTS converter closure (optional; no model weights)")
    print(f"  source: {ARCHIVE_URL}")
    print(f"  bytes: {ARCHIVE_SIZE}")
    print(f"  sha256: {ARCHIVE_SHA256}")
    print(f"  generation: {GENERATION}")
    print(f"  converter: {CONVERTER_PATH}")
    print("  Debian direct pins:")
    for package, version in PACKAGE_VERSIONS.items():
        print(f"    {package}={version}")


def main(argv: list[str] | None = None) -> int:
    args = parse_arguments(sys.argv[1:] if argv is None else argv)
    if args.dry_run:
        print_plan()
        return 0
    try:
        if args.verify:
            verify_packages()
            verify_generation()
            verify_wrapper()
            print(f"verified {CONVERTER_PATH}")
            return 0
        if os.geteuid() != 0:
            fail("installation must run as root (try sudo)")
        changed = install(args.archive.resolve(strict=True) if args.archive else None)
        print(("installed" if changed else "already verified"), CONVERTER_PATH)
        return 0
    except (InstallFailure, OSError, tarfile.TarError) as error:
        print(f"plebian-os-install-ollama-converter: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
