#!/usr/bin/env bash
#
# plebian-os-nvidia-driver — install NVIDIA's proprietary driver, the Debian way.
#
# OPTIONAL. Nothing runs this automatically and nothing depends on it. Plebian-OS
# ships the open-source `nouveau` driver, which drives a display on any supported
# card and needs no configuration. This helper exists for machines that need what
# nouveau cannot provide:
#
#   * CUDA — nouveau exposes no compute API at all
#   * NVENC / NVDEC hardware video encode and decode
#   * full memory and core clocks on recent silicon, where nouveau's reclocking
#     is limited or absent, so the card runs far below its rated speed
#
# If none of those matter on this machine, nouveau is the better choice: it is
# already installed, needs no out-of-tree kernel module, and never breaks on a
# kernel upgrade.
#
# WHAT "THE DEBIAN WAY" MEANS HERE
#
#   * the driver comes from Debian's own `non-free` component as a .deb, never
#     the .run installer from nvidia.com — that one installs outside dpkg,
#     overwrites libraries the package manager owns, and silently breaks on the
#     next kernel update
#   * `nvidia-detect` chooses the package by PCI ID rather than anyone guessing
#     a version
#   * the kernel module is built by DKMS against installed headers, so it
#     rebuilds itself on every future kernel upgrade
#   * nouveau is blacklisted by the driver package's own maintainer scripts, and
#     the initramfs regenerated by them — no hand-written modprobe files
#   * everything is tracked by dpkg, so `--rollback` can remove it cleanly
#
# Usage: plebian-os-nvidia-driver [--check|--status|--install|--rollback] [--yes] [--force]
#
#   --check     read-only preflight; changes nothing, needs no root
#   --status    what is installed and bound right now; also read-only
#   --install   install the driver; needs root, ends in a required reboot
#   --rollback  purge the driver and return to nouveau; also ends in a reboot
#   --yes       skip the confirmation prompt
#   --force     proceed past non-fatal preflight warnings
#
set -euo pipefail

SCRIPT_NAME=$(basename "$0")
BACKUP_DIR="/var/backups/plebian-os-nvidia-driver"
STAMP=$(date +%Y%m%d-%H%M%S)

MODE=""
ASSUME_YES=0
FORCE=0
WARNINGS=0

if [ -t 1 ]; then
  R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; B=$'\e[1m'; N=$'\e[0m'
else
  R=""; G=""; Y=""; B=""; N=""
fi
say()   { printf '%s\n' "$*"; }
head_() { printf '\n%s== %s ==%s\n' "$B" "$*" "$N"; }
ok()    { printf '  %s[ ok ]%s %s\n' "$G" "$N" "$*"; }
warn()  { printf '  %s[warn]%s %s\n' "$Y" "$N" "$*"; WARNINGS=$((WARNINGS+1)); }
die()   { printf '  %s[FAIL]%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
info()  { printf '  %s\n' "$*"; }

usage() {
  say "Usage: $SCRIPT_NAME [--check|--status|--install|--rollback] [--yes] [--force]"
  say ""
  say "  --check     read-only preflight; changes nothing, needs no root"
  say "  --status    what is installed and bound right now; also read-only"
  say "  --install   install the driver; needs root, ends in a required reboot"
  say "  --rollback  purge the driver and return to nouveau; also ends in a reboot"
  say "  --yes       skip the confirmation prompt"
  say "  --force     proceed past non-fatal preflight warnings"
  exit "${1:-0}"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --check|--dry-run) MODE=check ;;
    --install)         MODE=install ;;
    --status)          MODE=status ;;
    --rollback)        MODE=rollback ;;
    --yes|-y)          ASSUME_YES=1 ;;
    --force)           FORCE=1 ;;
    -h|--help)         usage 0 ;;
    *) say "$SCRIPT_NAME: unknown option: $1" >&2; usage 1 ;;
  esac
  shift
done
[ -n "$MODE" ] || usage 1

need_root() {
  [ "$(id -u)" -eq 0 ] || die "must run as root: sudo $SCRIPT_NAME --$MODE"
}

confirm() {
  [ "$ASSUME_YES" -eq 1 ] && return 0
  printf '\n%s%s%s [y/N] ' "$B" "$1" "$N"
  read -r reply </dev/tty || true
  case "$reply" in [yY]|[yY][eE][sS]) return 0 ;; *) say "aborted."; exit 1 ;; esac
}

# NOTE ON EARLY-EXITING greps AND pipefail
# ----------------------------------------
# This script runs under `set -o pipefail`. `grep -q` and `grep -m1` both exit
# the moment they have what they need, which closes the pipe and leaves the
# upstream command killed by SIGPIPE (exit 141). pipefail then reports that 141
# as the pipeline's status — so a SUCCESSFUL match either evaluates as FALSE
# (`grep -q`) or aborts the script under `set -e` (`grep -m1` in a command
# substitution). Everywhere below: capture output into a variable first, then
# match against a here-string, which is not a pipeline and cannot SIGPIPE.

# The PCI slot of the NVIDIA *display* device. An NVIDIA GPU also presents an
# audio function (HDMI/DP sound) on the adjacent slot, and it too reports as
# "NVIDIA Corporation" — matching on the vendor alone picks up snd_hda_intel
# and reports it as the GPU's driver. Always query the display slot explicitly.
GPU_SLOT=""

GPU_LINE=""
CUR_DRIVER=""
RUNNING_KERNEL=""
NEWEST_KERNEL=""
LSPCI_ALL=""

# Whether the driver is installable is decided by asking apt, not by parsing
# sources files: that works whatever the source layout or format happens to be.
# Candidate version apt would install for a package, or empty if there is none.
apt_candidate() {
  local pol cand
  pol=$(apt-cache policy "$1" 2>/dev/null || true)
  [ -n "$pol" ] || return 0
  cand=$(grep -m1 'Candidate:' <<<"$pol" | awk '{print $2}' || true)
  [ "$cand" = "(none)" ] && cand=""
  printf '%s' "$cand"
}

driver_available() {
  [ -n "$(apt_candidate nvidia-driver)" ]
}

# Decide whether this card is supported by a driver Debian actually ships.
#
# NVIDIA drops older GPU families from each driver branch, and Debian retires
# the corresponding legacy packages as they go unmaintained upstream. So a card
# can be old enough that nvidia-detect steers it to a legacy series that is no
# longer in the archive — installing the current driver on such hardware yields
# a machine whose X server will not start.
#
# Echoes the package to install on success. Returns 1 when the hardware is too
# old, or when nothing installable was identified.
#
# Callers pair this with legacy_series_of(). Both are pure — they take
# nvidia-detect's output and echo a result. Deliberately NOT setting a global
# to report the legacy series: this function is always called as `pkg=$(...)`,
# a command substitution, and a global assigned inside a subshell never reaches
# the caller. That bug shipped once and the tests now pin the behaviour.
resolve_driver_package() {
  local out="$1" pkg cand
  pkg=$(grep -A2 -i 'recommended to install' <<<"$out" \
        | grep -oE 'nvidia[a-z0-9.-]*driver[a-z0-9.-]*' | head -1 || true)

  if grep -qiE 'no longer supported|not supported by any|unsupported' <<<"$out"; then
    printf 'UNSUPPORTED'
    return 1
  fi
  if [ -z "$pkg" ]; then
    printf 'NORECOMMENDATION'
    return 1
  fi

  cand=$(apt_candidate "$pkg")
  if [ -z "$cand" ]; then
    # Typically a retired legacy series: recommended, but not in the archive.
    printf '%s' "$pkg"
    return 1
  fi

  printf '%s' "$pkg"
  return 0
}

# The legacy driver series nvidia-detect named, if any — e.g. "legacy 390xx".
# A packaged legacy series is installable, but the hardware is old enough that
# the caller should say so plainly before committing to it.
legacy_series_of() {
  grep -oiE 'legacy[ -]?[0-9]{3}xx' <<<"$1" | head -1 || true
}

preflight() {
  head_ "Preflight"

  local id ver
  id=$(. /etc/os-release && echo "${ID:-}")
  ver=$(. /etc/os-release && echo "${VERSION_ID:-}")
  if [ "$id" = "debian" ]; then ok "Debian ${ver:-?}"
  else warn "not Debian (found: ${id:-unknown}) — package names may differ"; fi

  LSPCI_ALL=$(lspci -nn 2>/dev/null || true)
  [ -n "$LSPCI_ALL" ] || die "lspci produced no output; install pciutils"
  GPU_LINE=$(grep -Ei 'vga|3d controller' <<<"$LSPCI_ALL" | grep -i nvidia | head -1 || true)
  [ -n "$GPU_LINE" ] || die "no NVIDIA GPU found on the PCI bus — nothing to do"
  ok "NVIDIA GPU: $(sed 's/.*: //' <<<"$GPU_LINE")"

  GPU_SLOT=$(awk '{print $1}' <<<"$GPU_LINE")
  local lspci_k
  lspci_k=$(lspci -k -s "$GPU_SLOT" 2>/dev/null || true)
  CUR_DRIVER=$(grep -m1 'Kernel driver in use' <<<"$lspci_k" | sed 's/.*: //' || true)
  info "current kernel driver: ${CUR_DRIVER:-<none bound>}"
  if [ "$CUR_DRIVER" = "nvidia" ]; then
    ok "the proprietary driver is already bound to this card"
  fi

  # Hybrid graphics: the integrated GPU keeps driving the panel. This is normal
  # and expected on laptops, and is not something the driver install changes.
  if grep -Eqi 'vga.*intel|vga.*amd|vga.*ati' <<<"$LSPCI_ALL"; then
    warn "hybrid graphics detected (integrated GPU + NVIDIA discrete GPU)"
    info "  the integrated GPU keeps driving the display. Run individual"
    info "  programs on the NVIDIA GPU with PRIME render offload:"
    info "    __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia <program>"
    info "  CUDA needs none of that — it addresses the device directly."
  fi

  local sb=""
  if command -v mokutil >/dev/null 2>&1; then
    sb=$(mokutil --sb-state 2>/dev/null || true)
  fi
  case "$sb" in
    *[Ee]nabled*)
      warn "Secure Boot is ENABLED"
      info "  a DKMS module builds fine and then refuses to load unless it is"
      info "  signed with an enrolled MOK. Enroll a key first, or disable"
      info "  Secure Boot in firmware."
      ;;
    *[Dd]isabled*) ok "Secure Boot disabled — DKMS modules load unsigned" ;;
    *)             info "Secure Boot state unverified (mokutil absent or needs root)" ;;
  esac

  RUNNING_KERNEL=$(uname -r)
  # Strip the "-unsigned" variant suffix before comparing: linux-image-X-unsigned
  # is the same kernel as linux-image-X, and sorts after it, which would
  # otherwise read as "a newer kernel is installed" on every signed-kernel host.
  local kernel_pkgs
  kernel_pkgs=$(dpkg-query -W -f='${Package}\n' 'linux-image-*' 2>/dev/null || true)
  NEWEST_KERNEL=$(sed -e 's/^linux-image-//' -e 's/-unsigned$//' <<<"$kernel_pkgs" \
                  | grep -E '^[0-9]' | sort -Vu | tail -1 || true)
  info "running kernel: $RUNNING_KERNEL"
  if [ -n "$NEWEST_KERNEL" ] && [ "$NEWEST_KERNEL" != "$RUNNING_KERNEL" ]; then
    warn "a newer kernel is installed but not booted: $NEWEST_KERNEL"
    info "  DKMS builds against the newest installed headers, and the reboot"
    info "  this install requires will boot that kernel — so they will match."
  else
    ok "running the newest installed kernel"
  fi

  dpkg -s dkms >/dev/null 2>&1 && ok "dkms installed" \
                               || info "dkms absent (will be installed)"

  # The component check that actually matters: can apt see the driver at all?
  if driver_available; then
    ok "nvidia-driver is available from apt (candidate: $(apt_candidate nvidia-driver))"
    # nvidia-detect is the authority on whether THIS card is still supported.
    # It lives in non-free and may not be installed yet; --install installs it
    # before committing to anything, and re-checks there.
    if command -v nvidia-detect >/dev/null 2>&1; then
      local det pkg legacy
      det=$(nvidia-detect 2>/dev/null || true)
      legacy=$(legacy_series_of "$det")
      if pkg=$(resolve_driver_package "$det"); then
        if [ -n "$legacy" ]; then
          warn "this GPU needs the $legacy driver series"
          info "  still packaged, but frozen upstream and eventually retired"
        fi
        ok "supported by an available driver: $pkg"
      else
        warn "this GPU is NOT supported by a driver Debian currently ships"
        info "  --install will refuse. Detail: $pkg"
      fi
    else
      info "nvidia-detect not installed — hardware support is confirmed at"
      info "  --install time, before anything is committed"
    fi
  else
    warn "apt cannot see nvidia-driver"
    info "  The driver lives in Debian's 'non-free' component. Plebian-OS"
    info "  enables it by default; a system provisioned before that, or one"
    info "  where it was turned off, will not have it."
    info "  Add 'non-free' to the Components: line of the relevant file under"
    info "  /etc/apt/sources.list.d/, then run: apt-get update"
    info "  This helper deliberately does not edit apt sources itself — those"
    info "  belong to the provisioner."
  fi

  local avail_mb
  avail_mb=$(df -Pm /var 2>/dev/null | awk 'NR==2{print $4}')
  if [ -n "${avail_mb:-}" ] && [ "$avail_mb" -lt 2048 ]; then
    warn "only ${avail_mb} MB free on /var — driver plus headers need roughly 1.5 GB"
  else
    ok "disk space: ${avail_mb:-?} MB free on /var"
  fi

  # A metered or slow link makes a several-hundred-MB download painful; say so
  # rather than letting it be discovered halfway through.
  local wl="" d wifi_up=0 eth_up=0
  for d in /sys/class/net/wl*; do
    [ -e "$d" ] || continue
    wl=$d
    [ "$(cat "$d/operstate" 2>/dev/null)" = "up" ] && wifi_up=1
  done
  for d in /sys/class/net/en* /sys/class/net/eth*; do
    [ -e "$d" ] || continue
    [ "$(cat "$d/operstate" 2>/dev/null)" = "up" ] && eth_up=1
  done
  if [ -n "$wl" ] && [ "$wifi_up" -eq 1 ] && [ "$eth_up" -eq 0 ]; then
    warn "on wireless with no wired link — this download is several hundred MB"
    info "  a cable, if one is available, makes this considerably faster"
  fi

  head_ "Preflight summary"
  if [ "$WARNINGS" -eq 0 ]; then ok "no warnings"
  else say "  $WARNINGS warning(s) above."; fi
}

do_install() {
  need_root
  preflight

  driver_available || die "nvidia-driver is not available from apt; see the preflight note above"

  if [ "$WARNINGS" -gt 0 ] && [ "$FORCE" -ne 1 ]; then
    say ""
    say "  Preflight raised warnings. Review them, then re-run with --force,"
    say "  or fix the underlying issue first."
    confirm "Continue anyway?"
  fi

  confirm "Install the NVIDIA driver? This ends with a required REBOOT."

  export DEBIAN_FRONTEND=noninteractive

  head_ "Asking nvidia-detect which driver this card needs"
  apt-get install -y nvidia-detect
  local detect_out pkg
  detect_out=$(nvidia-detect 2>/dev/null || true)
  say ""
  sed 's/^/    /' <<<"$detect_out"

  # Hardware-age gate. Refuse rather than install a driver that cannot drive
  # this card — the failure mode otherwise is an X server that will not start
  # after the reboot, on a machine that was working fine on nouveau.
  if ! pkg=$(resolve_driver_package "$detect_out"); then
    case "$pkg" in
      UNSUPPORTED)
        die "this GPU is too old: no driver Debian ships still supports it.
       nvidia-detect reports it as unsupported. Staying on nouveau is the
       correct outcome here — it remains the only working driver for this
       card, and no action is needed." ;;
      NORECOMMENDATION)
        die "nvidia-detect identified no driver for this GPU.
       Refusing rather than guessing: installing the wrong driver leaves a
       machine that will not start X after the reboot." ;;
      *)
        die "this GPU needs '$pkg', which Debian no longer ships.
       That is a retired legacy series — the hardware is older than any
       currently packaged driver supports. Staying on nouveau is correct." ;;
    esac
  fi

  local legacy
  legacy=$(legacy_series_of "$detect_out")
  if [ -n "$legacy" ]; then
    warn "this GPU needs the $legacy driver series"
    info "  it is still packaged, but frozen upstream and will be retired"
    info "  eventually. nouveau remains a supported alternative."
    confirm "Install the $legacy driver anyway?"
  fi
  ok "nvidia-detect recommends: $pkg (candidate $(apt_candidate "$pkg"))"

  head_ "Installing headers, DKMS and the driver"
  # linux-headers-amd64 tracks the kernel meta-package, so a future kernel
  # upgrade pulls matching headers and DKMS rebuilds the module unattended.
  apt-get install -y linux-headers-amd64 dkms
  ok "headers and dkms installed"

  apt-get install -y "$pkg"
  ok "$pkg installed"

  head_ "Verifying the DKMS build"
  if command -v dkms >/dev/null 2>&1; then
    local dkms_out
    dkms_out=$(dkms status 2>/dev/null || true)
    sed 's/^/    /' <<<"$dkms_out"
    if grep -qi 'installed' <<<"$dkms_out"; then
      ok "DKMS module built and installed"
    else
      warn "DKMS does not report an installed module — check 'dkms status'"
    fi
  fi

  head_ "nouveau blacklist"
  if grep -rlq nouveau /etc/modprobe.d/ 2>/dev/null; then
    ok "installed by the driver package:"
    grep -rl nouveau /etc/modprobe.d/ 2>/dev/null | sed 's/^/    /'
  else
    warn "no nouveau blacklist found — nouveau may still claim the card"
  fi

  head_ "Done — reboot required"
  say "  The NVIDIA module cannot replace nouveau until this machine reboots."
  if [ -n "$NEWEST_KERNEL" ] && [ "$NEWEST_KERNEL" != "$RUNNING_KERNEL" ]; then
    say "  Note: the reboot also moves this machine from kernel"
    say "        $RUNNING_KERNEL to $NEWEST_KERNEL."
  fi
  say ""
  say "    reboot"
  say ""
  say "  Afterwards:  $SCRIPT_NAME --status   and   nvidia-smi"
}

do_status() {
  head_ "Video driver status"

  local lspci_all gpu slot lspci_k drv lsmod_out dpkg_out
  lspci_all=$(lspci -nn 2>/dev/null || true)
  grep -Ei 'vga|3d controller' <<<"$lspci_all" | sed 's/^/    /' || true
  say ""

  # Query the display slot specifically: the GPU's companion HDMI audio
  # function also reports as NVIDIA and would otherwise be read as the GPU.
  gpu=$(grep -Ei 'vga|3d controller' <<<"$lspci_all" | grep -i nvidia | head -1 || true)
  if [ -n "$gpu" ]; then
    slot=$(awk '{print $1}' <<<"$gpu")
    lspci_k=$(lspci -k -s "$slot" 2>/dev/null || true)
    drv=$(grep -m1 'Kernel driver in use' <<<"$lspci_k" | sed 's/.*: //' || true)
    info "NVIDIA GPU at $slot — kernel driver in use: ${drv:-<none bound>}"
  else
    info "no NVIDIA GPU present"
  fi

  lsmod_out=$(lsmod 2>/dev/null || true)
  info "loaded modules: $(awk '{print $1}' <<<"$lsmod_out" \
        | grep -Ex 'nvidia|nvidia_drm|nvidia_modeset|nvidia_uvm|nouveau|i915|amdgpu' \
        | tr '\n' ' ' || true)"

  say ""
  dpkg_out=$(dpkg -l 2>/dev/null || true)
  if grep -qE '^ii[[:space:]]+nvidia-driver' <<<"$dpkg_out"; then
    ok "nvidia-driver installed:"
    grep -E '^ii[[:space:]]+(nvidia|libnvidia)' <<<"$dpkg_out" \
      | awk '{print "    "$2" "$3}' | head -20
  else
    info "no nvidia-driver package installed (running the open-source stack)"
  fi

  say ""
  if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi 2>&1 | head -12 | sed 's/^/    /'
  else
    info "nvidia-smi not present"
  fi

  say ""
  if command -v dkms >/dev/null 2>&1; then
    info "dkms status:"
    sed 's/^/    /' <<<"$(dkms status 2>/dev/null || true)"
  fi

  say ""
  info "running kernel: $(uname -r)"
}

do_rollback() {
  need_root
  head_ "Rollback — remove the NVIDIA driver and return to nouveau"

  local dpkg_out
  dpkg_out=$(dpkg -l 2>/dev/null || true)
  if ! grep -qE '^ii[[:space:]]+nvidia' <<<"$dpkg_out"; then
    ok "no nvidia packages installed — nothing to roll back"
    return 0
  fi

  say "  Every installed nvidia* package will be purged and nouveau restored."
  confirm "Proceed with rollback? This ends with a required REBOOT."

  export DEBIAN_FRONTEND=noninteractive

  apt-get purge -y '~nnvidia' || apt-get purge -y 'nvidia-*' 'libnvidia-*'
  apt-get autoremove -y --purge
  ok "nvidia packages purged"

  # Purging the driver removes its own blacklist; sweep any that outlive it.
  local f
  for f in /etc/modprobe.d/*nvidia*nouveau* /etc/modprobe.d/*blacklist-nouveau*; do
    [ -e "$f" ] || continue
    mkdir -p "$BACKUP_DIR"
    mv "$f" "$BACKUP_DIR/$(basename "$f").$STAMP"
    ok "moved stray blacklist $f to $BACKUP_DIR"
  done

  update-initramfs -u
  ok "initramfs rebuilt"

  head_ "Done — reboot required"
  say "    reboot"
}

case "$MODE" in
  # --check and --status only read state, so neither requires root.
  check)    preflight
            say ""
            say "  Read-only: nothing was changed."
            say "  When ready:  sudo $SCRIPT_NAME --install" ;;
  install)  do_install ;;
  status)   do_status ;;
  rollback) do_rollback ;;
esac
