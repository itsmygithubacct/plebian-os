{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plebian.setup.optional-component/v1",
  "title": "Plebian setup optional-component offer record v1 (F107-B review draft)",
  "$comment": "Review-only pre-gate draft. It describes offer metadata and grants no consent or installation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "label",
    "disclosures",
    "authorization_ref",
    "license_ref",
    "provider"
  ],
  "properties": {
    "schema": {
      "const": "plebian.setup.optional-component/v1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "disclosures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/disclosure"
      }
    },
    "authorization_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authorization_id"
      ],
      "properties": {
        "schema": {
          "const": "kilix.install.authorization/v2"
        },
        "authorization_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "license_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "license_id",
        "license_text_sha256",
        "decision_class"
      ],
      "properties": {
        "schema": {
          "const": "kilix.install.license/v1"
        },
        "license_id": {
          "$ref": "#/$defs/id"
        },
        "license_text_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "decision_class": {
          "enum": [
            "informational",
            "affirmative",
            "user-supplied",
            "restricted"
          ]
        }
      }
    },
    "provider": {
      "$ref": "#/$defs/id"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject",
        "text"
      ],
      "properties": {
        "kind": {
          "enum": [
            "third-party-repository",
            "foreign-architecture",
            "additional-debian-component",
            "self-update"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        }
      }
    }
  }
}
