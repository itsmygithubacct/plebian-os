# Plebian-OS 0.2.2 release environment.
#
# STATUS: coordinated closure CANDIDATE, assembled on work/0.2.2-closure-advance.
# NOT a freeze and NOT yet a release: nothing here is tagged, built, or
# accepted. Every *_REF is a bare 40-character SHA that was fetched from its
# remote by SHA before being written here, except PLEBIAN_OS_REF, which is the
# release tag by the recorded exception (see its comment). Where a pin moved
# since 0.2.1 the comment above it says from what, to what, and why; where it
# did not move the comment says "held". The same values, in the same order,
# are mirrored in the closure table of releases/0.2.2-notes.md, and
# tests/test_release_versioning.py refuses a mismatch between the two.
#
# What each advance bought is in CHANGELOG.md under [0.2.2]; the 0.2.1 -> 0.2.2
# transition an installed machine goes through is in UPGRADING.md. 0.2.1's own
# selection history stays in releases/0.2.1.env and is not repeated here.

PLEBIAN_OS_VERSION=0.2.2
PLEBIAN_OS_RELEASE_MODE=1

# F107-A: normal media ships no account or password, so the deprecated
# IMAGE_PASSWORD / RANDOM_PASSWORD keys are absent by requirement, not by
# oversight — remaster-iso.sh refuses this manifest if either is merely set.

# The release tag, which the owner creates at RELEASING.md "Cutting 0.2.2"
# step 4, after the closure commit it names. This is the one ref that is not a
# bare SHA, and the reason is structural: release mode requires this ref to
# resolve to the provisioner's own HEAD, and no commit can contain its own SHA,
# so only a tag created after the commit can close that loop. Two consequences:
# until the tag exists, test_release_versioning fails by name; and the tag must
# be on the remote before any install is attempted, because first boot clones
# it — 0.2.1 learned this with a candidate that named a tag nobody had created,
# retried the clone three times, and came up as stock Debian.
PLEBIAN_OS_REF=v0.2.2
PLEBIAN_OS_REPO=https://github.com/itsmygithubacct/plebian-os.git
PLEBIAN_OS_BRANCH=

# Advanced from 0.2.1's 6e1d3cc, 4 commits: VERSION 0.2.2; the suite stops
# depending on the operator's ambient session and gets one environment
# sanitiser instead of four; and the session holds the X CLIPBOARD and PRIMARY
# selections through autocutsel so copied text outlives the app that copied it
# (PLEB_CLIPBOARD opts out).
PLEB_REF=3f8d1720ff7b8fb5e61ea5621c9f9e27eed1332e
PLEB_REPO=https://github.com/itsmygithubacct/pleb.git
PLEB_BRANCH=
# Advanced from 0.2.1's a4d1e0fb, 4 commits: VERSION and provider manifest
# 0.2.2 with a test that keeps them together; send-text allowed within one OS
# window on the unauthenticated path, with the window rule tested; two fixtures
# no longer race make's timestamps. Everything 0.2.1 gated — the Kitty 0.48.2
# engine and the CVE-2026-72913 fix that entered at 6e1f2de5 — is an ancestor
# of this commit. The provisioner asserts the built engine reports exactly
# '0.2.2', which is why the version commit is the pin and not merely somewhere
# on the branch: 0.2.1's first candidate failed every install on that assertion.
KILIX_REF=15ab485e56a64e70e6117a0e95fe71e7d05dbddb
KILIX_REPO=https://github.com/itsmygithubacct/kilix.git
KILIX_BRANCH=
# Advanced from 0.2.1's c6ec9205, 5 commits: VERSION and provider manifest
# 0.2.2; Settings surfaces KILIX_CHROME_TAB_BAR_EDGE, a shared setting it had
# never exposed; the test runner stops inheriting exported shell functions; and
# CI pins against KILIX_REF above instead of 0.1.9's commit. Verified by
# execution: `main.py --version` prints `kilix-95 0.2.2`, the exact string the
# provisioner compares.
KILIX95_REF=8362eee91dc313600588d5f3f8f0e2260f519ae6
KILIX95_REPO=https://github.com/itsmygithubacct/kilix-95.git
KILIX95_BRANCH=

# Repository-root tuples. Component versions and child gitlink SHAs are
# verified from the manifests and trees these roots select, never duplicated
# here.
# Held from 0.2.1: the work/0.2.1-f106 tip 0.2.1 selected because the pin
# before it could not build under the release-pinned uv 0.12.5. Its own gate
# still prints "release authority blocked; no qualification claim" — the
# component's verdict on itself, carried rather than overruled.
KILIX_SYSTEM_MONITOR_REF=df85340488c0060bb40aa8c62c21d4d240a2beb9
KILIX_SYSTEM_MONITOR_REPO=https://github.com/itsmygithubacct/kilix-system-monitor.git
KILIX_SYSTEM_MONITOR_BRANCH=
# Advanced from 0.2.1's c19c5452, 7 commits, to work/0.2.1-repo-fixes-r1. Two
# independent seats ACCEPT the advance (0 Critical, 0 High); the graded commit
# is 3da47dec and 401b8ef9 is its strict descendant one commit ahead, changing
# 8 files — Makefiles and tests, no vendored or imported source.
# `git diff --name-only c19c5452 3da47dec -- components/` is 0 files.
# tools/check-upstream.py exits 1 at both commits: a known Medium that tests
# ref-tip equality rather than reachability, quoted here and not repaired.
KILIX_DESKTOP_SDK_REF=401b8ef9a09690c529ca41c8c89f7f6c2814e141
KILIX_DESKTOP_SDK_REPO=https://github.com/itsmygithubacct/kilix-desktop-sdk.git
KILIX_DESKTOP_SDK_BRANCH=
# Advanced from 0.2.1's 0b9f11b4, 7 commits, to the revision the desktop SDK
# is conformance-bound against. At the old pin bin/kilix-icewm hashed
# 9d375fe9… against the SDK's recorded 89bcbf1c…, and contract_bridge.py, which
# the SDK's kilix-95 main imports, was absent; at this pin both match and the
# component's own suite goes from 57 to 89 tests. The old pin is an ancestor of
# this one. Mandatory F110 contract/conformance consumer.
KILIX_ICEWM_REF=ea45b9abf13688154fdb4146cdfa4ffdef4399f1
KILIX_ICEWM_REPO=https://github.com/itsmygithubacct/kilix-icewm.git
KILIX_ICEWM_BRANCH=
# Held from 0.2.1: the reviewed work/f111-kilix-acoustic-link tip. F111 was
# deferred out of 0.2.1 and has not been re-scoped; the manifest at this commit
# records one of six planned components present and 0/6 physical profiles
# graduated, which is the parent's verdict on itself.
KILIX_MEDIA_SDK_REF=acedb780a9470ee88d0b2915990f4fb8a51e68fa
KILIX_MEDIA_SDK_REPO=https://github.com/itsmygithubacct/kilix-media-sdk.git
KILIX_MEDIA_SDK_BRANCH=
# Held from 0.2.1, for the reason 0.2.1 recorded once it had been measured:
# 4a331173 is HEAD and refs/heads/main of kilix-waydroid and the tree there IS
# the F121 application; F121 was deferred out of 0.2.1 and is not implemented
# for 0.2.2 either; and no provisioning path clones or installs this
# repository — every reference to it is closure validation, a release-mode
# canonicality check, or manifest/provenance recording. The OS half is pinned
# separately below as PLEBIAN_OS_INSTALL_WAYDROID / _WAYDROID_CLOSURE_SHA256.
#
# It stays because release mode puts KILIX_WAYDROID_REF in the required-refs
# loop and refuses a build without a canonical 40-character SHA. Removing it
# needs the F120 root list amended in the same change, which is an owner
# decision and has not been made. So a deferred stream's commit is still a
# hard precondition for a release build, and that is worth knowing rather than
# papering over.
KILIX_WAYDROID_REF=4a331173caf36b3235679715e153e4154b85651f
KILIX_WAYDROID_REPO=https://github.com/itsmygithubacct/kilix-waydroid.git
KILIX_WAYDROID_BRANCH=

# Held deliberately, not rechecked: archived Debian 13.5.0 installer media and
# the signed trixie snapshot. Repeated verbatim from releases/0.2.2.requirements.
PLEBIAN_OS_NETINST_URL=https://cdimage.debian.org/cdimage/archive/13.5.0/amd64/iso-cd/debian-13.5.0-amd64-netinst.iso
PLEBIAN_OS_NETINST_SHA256=95838884f5ea6c82421dfe6baaa5a639dbbe6756c1e380f9fe7a7cb0c1949d2a
PLEBIAN_OS_NETINST_MAX_BYTES=791674880
PLEBIAN_OS_APT_SNAPSHOT=20260727T000000Z

# F118, carried from 0.2.1: verified fallback engine 0.48.2, which carries the
# CVE-2026-72913 fix; 0.47.4 carried the pre-fix remote-echo filter. The digest
# is of kitty-0.48.2-x86_64.txz at the release URL bootstrap.sh builds.
KILIX_PREBUILT_VERSION=0.48.2
KILIX_PREBUILT_SHA256=967a1958e7fc67b495d279c0963bcd1a0482097151817ce6506fabc822689af7
PLEBIAN_OS_BUILD_KILIX_FORK=1

# Exact Go toolchain required by the coordinated Kilix engine. Kitty 0.48.2's
# go.mod keeps `go 1.26.0` but moves `toolchain` to go1.27.0.
PLEBIAN_OS_KILIX_GO_MIN_VERSION=1.26
PLEBIAN_OS_KILIX_GO_VERSION=go1.27.0
PLEBIAN_OS_KILIX_GO_SHA256_AMD64=675c26c449cbb18fc24b74650de1eabbae6e16f64326fd85a283fb3b58280685
PLEBIAN_OS_KILIX_GO_SHA256_ARM64=51798d2c42d0e1c6ed7fd9f48728b4193abac9e8aad6dbac2fe96a81f5909bda

# Release session contract, carried unchanged from the accepted 0.2.0 closure.
PLEBIAN_OS_DESKTOP=1
PLEBIAN_OS_KIOSK=0
KILIX_DESKTOP_PROVIDER=external
KILIX_DESKTOP_FLAVOR=95
KILIX95_AUTO_INSTALL=1
KILIX_RUN_ALIASES=1

# Required checksum-verified system uv installation, from the requirements.
PLEBIAN_OS_INSTALL_UV=1
PLEBIAN_OS_UV_VERSION=0.12.5
PLEBIAN_OS_UV_INSTALLER_SHA256=504511fbbbd811aeaba6738abc79408956b6c7da0ca35437b3dcc24a41efc111
PLEBIAN_OS_UV_INSTALLER_MAX_BYTES=71225

# Read-aloud and offline-dictation closure. KILIX_VOICE_REF advances from
# 0.2.1's f501409a by one commit, a test fix: the catalog test read the
# operator's selected model through the shared settings file and failed on any
# machine whose choice was not the default. No runtime change. The library, the
# model and their digests are held at the accepted 0.2.0 selection.
KILIX_VOICE_REF=ba15d849486d19967f0e543f21bdfdfaf93df4fe
KILIX_VOICE_LIB_VERSION=0.3.45
KILIX_VOICE_LIB_URL=https://files.pythonhosted.org/packages/fc/ca/83398cfcd557360a3d7b2d732aee1c5f6999f68618d1645f38d53e14c9ff/vosk-0.3.45-py3-none-manylinux_2_12_x86_64.manylinux2010_x86_64.whl
KILIX_VOICE_LIB_SHA256=25e025093c4399d7278f543568ed8cc5460ac3a4bf48c23673ace1e25d26619f
KILIX_VOICE_MODEL_URL=https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip
KILIX_VOICE_MODEL_SHA256=30f26242c4eb449f948e42cb302dd7a686cb29a3423a8367f99ff41780942498
PLEBIAN_OS_INSTALL_VOICE_MODEL=1

# Hash-bound Waydroid first-use closure, from the requirements.
PLEBIAN_OS_INSTALL_WAYDROID=1
PLEBIAN_OS_WAYDROID_CLOSURE_SHA256=4ad7a4d44eef6ce4e90173491d0c6c8da02b3764d0d20d1df67ca7eeaa7e4175
