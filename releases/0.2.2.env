# 0.2.1 release environment.
#
# STATUS: P0 WORKING SET, approved by the owner 2026-08-30. NOT a freeze.
# Six of these refs are unreviewed work/* or main tips; only KILIX_REF has
# passed a gate. The freeze MUST re-pin every field to a reviewed ref.
# Bare SHAs are the convention (PLEBIAN_OS_REF=v0.2.x is the recorded
# exception); no v0.2.1 tag exists in any of the eight repositories, and
# creating release tags is owner-reserved.
# Basis for each selection: 0.2.1-RELEASE-ENV-REF-PROPOSAL.md
#
# Plebian-OS 0.2.1 — coordinated closure CANDIDATE, prepared by Track C.
#
# THIS FILE IS NOT FINAL. `releases/0.2.1.env` is owner-final: Track C prepares
# the derivable half and files it for sign-off. Eight values below are declared
# and deliberately left EMPTY because each is an owner selection, not something
# a builder may infer from whatever a branch happens to point at today:
#
#   PLEB_REF                    pleb
#   KILIX_REF                   kilix
#   KILIX95_REF                 kilix-95
#   KILIX_SYSTEM_MONITOR_REF    kilix-system-monitor  (repository published empty)
#   KILIX_DESKTOP_SDK_REF       kilix-desktop-sdk     (repository published empty)
#   KILIX_ICEWM_REF             kilix-icewm
#   KILIX_MEDIA_SDK_REF         kilix-media-sdk       (repository published empty)
#   KILIX_WAYDROID_REF          kilix-waydroid
#
# Empty is deliberate and fail-closed: `release_preflight` and
# `validate_f120_release_roots` refuse a release build by name until each is
# filled, so this candidate cannot be mistaken for a finished manifest or built
# into an image labelled 0.2.1. Placeholder text was NOT used: the manifest
# loader rejects the placeholder class outright, and a fabricated SHA is worse
# than an absent one. The measured advertised head of each repository, and its
# bare-SHA fetchability, are recorded in the Track C release-environment
# candidate record rather than inferred into this file.
#
# Every value that IS filled below is derived and independently proven; see the
# same record for each derivation and its control.

PLEBIAN_OS_VERSION=0.2.2
PLEBIAN_OS_RELEASE_MODE=1

# F107-A: normal media ships no account or password, so the deprecated
# IMAGE_PASSWORD / RANDOM_PASSWORD keys are absent by requirement, not by
# oversight — remaster-iso.sh refuses this manifest if either is merely set.

# Owner selection 2026-08-31: the RC tag, created for this candidate.
#
# It was `v0.2.1`, a tag nobody had created: first boot clones this ref from the
# remote, so every fresh install retried the clone three times, failed
# provisioning, and came up as a stock Debian desktop with none of the product
# on it. A bare SHA was tried next and cannot work here — release mode requires
# this ref to resolve to HEAD, and no commit can contain its own SHA. A tag is
# created after the commit it names, which is the only thing that closes that
# loop, and is what the exception in this file has always been for. `-rc1` says
# plainly that this is a candidate and not the release.
PLEBIAN_OS_REF=v0.2.2
PLEBIAN_OS_REPO=https://github.com/itsmygithubacct/plebian-os.git
PLEBIAN_OS_BRANCH=

# main @ 071aeaf. Owner-selected 2026-08-31 (advanced from 00f578a2, a clean
# ancestor 3 commits back). Carries F109's P1 plus the install-path refusal fix:
# the refusal must not advise a stash that skips untracked files. Tested 11/11,
# 10/10 mutations killed, remote-verified on pleb main.
PLEB_REF=6e1d3cc691e025a3ec503433e0b8b9a6dc7913d7
PLEB_REPO=https://github.com/itsmygithubacct/pleb.git
PLEB_BRANCH=
# work/0.2.1-track-c-f118-consumer-kitty tip. Carries the Kitty 0.48.2 advance
# and therefore the CVE-2026-72913 fix, which entered at 6e1f2de5 and is an
# ancestor of this commit, so nothing gated is given up.
#
# Advanced 6e1f2de5 -> a4d1e0fb (owner selection 2026-09-01). 6e1f2de5's VERSION
# file still reads 0.2.0, and the provisioner asserts the built engine reports
# the release version exactly: every install of the previous candidate failed
# with `kilix reports '0.2.0', expected exactly '0.2.1'` and rolled itself back,
# leaving a machine with no Pleb session. a4d1e0fb is "Prepare Kilix 0.2.1" and
# changes three files - VERSION, README.md, desktop/provider.json - and no code.
KILIX_REF=a4d1e0fbc76d79cb071868d38b05d8c20c2ebd45
KILIX_REPO=https://github.com/itsmygithubacct/kilix.git
KILIX_BRANCH=
# work/0.2.1-version-bump. Advanced 94a1237d -> c6ec9205 on 2026-09-01, for the
# same reason KILIX_REF moved: the provisioner asserts each installed component
# reports the release version exactly, and NO ref in this repository carried
# 0.2.1 -- main and work/0.2.1-track-e both read 0.2.0, feat/host-parity reads
# 0.1.8 -- so no pin could have passed. c6ec9205 is based on 94a1237d, the
# commit this closure already selected, and changes VERSION and provider.json
# and nothing else. Verified by execution: `main.py --version` prints
# `kilix-95 0.2.1`, which is the exact string the assertion compares.
KILIX95_REF=c6ec9205412d034966f22825b4bbb893968fe1e8
KILIX95_REPO=https://github.com/itsmygithubacct/kilix-95.git
KILIX95_BRANCH=

# 0.2.1 repository-root tuples. Component versions and child gitlink SHAs are
# verified from the manifests and trees these roots select, never duplicated
# here.
# work/0.2.1-f106 tip. Advanced da938a6d -> df853404 on 2026-09-01: the previous
# pin could not build at all -- `uv build` exit 2 with 0 artifacts under the
# release-pinned uv 0.12.5, measured at the pinned commit rather than the branch.
# The packaging fix existed on this branch and the release was not shipping it.
KILIX_SYSTEM_MONITOR_REF=df85340488c0060bb40aa8c62c21d4d240a2beb9
KILIX_SYSTEM_MONITOR_REPO=https://github.com/itsmygithubacct/kilix-system-monitor.git
KILIX_SYSTEM_MONITOR_BRANCH=
# work/0.2.1-f110-monorepo-r1, published 2026-08-30 after the owner granted the
# parent's 536 hygiene units (OD-28b). UNREVIEWED: F110 holds 0/2 independent
# seats, so this is a working pin like the other six, not a freeze pin.
KILIX_DESKTOP_SDK_REF=401b8ef9a09690c529ca41c8c89f7f6c2814e141
KILIX_DESKTOP_SDK_REPO=https://github.com/itsmygithubacct/kilix-desktop-sdk.git
KILIX_DESKTOP_SDK_BRANCH=
# main. Mandatory F110 contract/conformance consumer.
KILIX_ICEWM_REF=0b9f11b45fddc5370c37b00e9cd9e42ac5a5f6d7
KILIX_ICEWM_REPO=https://github.com/itsmygithubacct/kilix-icewm.git
KILIX_ICEWM_BRANCH=
# work/f111-kilix-acoustic-link tip. Advanced 63796a37 -> acedb780 on 2026-09-01:
# the repository review's MSDK-01 recorded that the closure shipped one commit
# behind the reviewed tip. This is that tip, on the same reviewed branch.
KILIX_MEDIA_SDK_REF=acedb780a9470ee88d0b2915990f4fb8a51e68fa
KILIX_MEDIA_SDK_REPO=https://github.com/itsmygithubacct/kilix-media-sdk.git
KILIX_MEDIA_SDK_BRANCH=
# RETAINED, and the previous comment here was wrong on every count. It claimed
# this "is NOT an F121 pin" and "serves the OS half". Measured 2026-09-01:
# 4a331173 is HEAD and refs/heads/main of kilix-waydroid and the tree at that SHA
# IS the F121 application; the OS half is pinned separately in this same file as
# PLEBIAN_OS_INSTALL_WAYDROID / PLEBIAN_OS_WAYDROID_CLOSURE_SHA256; and no
# provisioning path clones or installs KILIX_WAYDROID_REPO at all - every
# reference to it is closure validation, a release-mode canonicality check, or
# manifest/provenance recording.
#
# It IS an F121 pin, and F121 was deferred to 0.2.2 - see
# 0.2.1-F121-DEFERRAL-SCOPE-CHANGE.md.
#
# It is retained anyway because it cannot simply be dropped: release mode puts
# KILIX_WAYDROID_REF in the required-refs loop and refuses a build without a
# canonical 40-character SHA. Removing it needs the F120 root list amended in the
# same change, which is an owner decision and has not been made. So a deferred
# stream's commit is currently a hard precondition for a 0.2.1 release build,
# and that is worth knowing rather than papering over.
KILIX_WAYDROID_REF=4a331173caf36b3235679715e153e4154b85651f
KILIX_WAYDROID_REPO=https://github.com/itsmygithubacct/kilix-waydroid.git
KILIX_WAYDROID_BRANCH=

# Held deliberately, not rechecked: archived Debian 13.5.0 installer media and
# the signed trixie snapshot. Repeated verbatim from releases/0.2.1.requirements.
PLEBIAN_OS_NETINST_URL=https://cdimage.debian.org/cdimage/archive/13.5.0/amd64/iso-cd/debian-13.5.0-amd64-netinst.iso
PLEBIAN_OS_NETINST_SHA256=95838884f5ea6c82421dfe6baaa5a639dbbe6756c1e380f9fe7a7cb0c1949d2a
PLEBIAN_OS_NETINST_MAX_BYTES=791674880
PLEBIAN_OS_APT_SNAPSHOT=20260727T000000Z

# F118: verified fallback engine moved 0.47.4 -> 0.48.2. 0.47.4 carries the
# pre-fix remote-echo filter of CVE-2026-72913; 0.48.2 carries the fix. The
# digest is of kitty-0.48.2-x86_64.txz at the release URL bootstrap.sh builds.
KILIX_PREBUILT_VERSION=0.48.2
KILIX_PREBUILT_SHA256=967a1958e7fc67b495d279c0963bcd1a0482097151817ce6506fabc822689af7
PLEBIAN_OS_BUILD_KILIX_FORK=1

# Exact Go toolchain required by the coordinated Kilix engine. Kitty 0.48.2's
# go.mod keeps `go 1.26.0` but moves `toolchain` to go1.27.0.
PLEBIAN_OS_KILIX_GO_MIN_VERSION=1.26
PLEBIAN_OS_KILIX_GO_VERSION=go1.27.0
PLEBIAN_OS_KILIX_GO_SHA256_AMD64=675c26c449cbb18fc24b74650de1eabbae6e16f64326fd85a283fb3b58280685
PLEBIAN_OS_KILIX_GO_SHA256_ARM64=51798d2c42d0e1c6ed7fd9f48728b4193abac9e8aad6dbac2fe96a81f5909bda

# Release session contract, carried unchanged from the accepted 0.2.0 closure.
PLEBIAN_OS_DESKTOP=1
PLEBIAN_OS_KIOSK=0
KILIX_DESKTOP_PROVIDER=external
KILIX_DESKTOP_FLAVOR=95
KILIX95_AUTO_INSTALL=1
KILIX_RUN_ALIASES=1

# Required checksum-verified system uv installation, from the requirements.
PLEBIAN_OS_INSTALL_UV=1
PLEBIAN_OS_UV_VERSION=0.12.5
PLEBIAN_OS_UV_INSTALLER_SHA256=504511fbbbd811aeaba6738abc79408956b6c7da0ca35437b3dcc24a41efc111
PLEBIAN_OS_UV_INSTALLER_MAX_BYTES=71225

# Read-aloud and offline-dictation closure, held at the accepted 0.2.0
# selection. Moving it is an owner decision and no record selects a successor.
KILIX_VOICE_REF=f501409a82bf73b738b14986e12441bce23ec1c6
KILIX_VOICE_LIB_VERSION=0.3.45
KILIX_VOICE_LIB_URL=https://files.pythonhosted.org/packages/fc/ca/83398cfcd557360a3d7b2d732aee1c5f6999f68618d1645f38d53e14c9ff/vosk-0.3.45-py3-none-manylinux_2_12_x86_64.manylinux2010_x86_64.whl
KILIX_VOICE_LIB_SHA256=25e025093c4399d7278f543568ed8cc5460ac3a4bf48c23673ace1e25d26619f
