# Plebian-OS 0.1.6 — authoritative coordinated release closure.
#
# A named release manifest overrides ambient values for every key it contains.
# The OS tag is resolved only while building; the installed image persists that
# resolved commit, not the movable tag name. Related repositories use full
# commit IDs directly.
#
# The upstream inputs below were re-verified against their official sources on
# 2026-07-31. The three component refs are the reviewed release-prep branch
# tips. Step 2 of RELEASING.md still re-confirms them, and the Go version below,
# immediately before tagging.

PLEBIAN_OS_VERSION=0.1.6
PLEBIAN_OS_RELEASE_MODE=1

# The OS commit is self-referential until the release commit is tagged.
PLEBIAN_OS_REF=v0.1.6
PLEBIAN_OS_REPO=https://github.com/itsmygithubacct/plebian-os.git
PLEBIAN_OS_BRANCH=

# Coordinated related source commits. Fill each with the reviewed branch tip
# immediately before tagging, then re-confirm none of the four has moved.
PLEB_REF=365b1603325e77910210d64c10d1942bdcaacf7a
PLEB_REPO=https://github.com/itsmygithubacct/pleb.git
PLEB_BRANCH=
KILIX_REF=1d97a1b6c5cc953958f3af30cb42a7382a146ee0
KILIX_REPO=https://github.com/itsmygithubacct/kilix.git
KILIX_BRANCH=
KILIX95_REF=544f091b8f9fc01f30023d204967bce3150800fa
KILIX95_REPO=https://github.com/itsmygithubacct/kilix-95.git
KILIX95_BRANCH=

# Signed, archived Debian 13.5 installer media and a fixed trixie package
# snapshot covering both Installer and firstboot package resolution.
#
# 13.5.0 is retained deliberately: Debian 13.6.0 exists but is still served only
# from the mutable /debian-cd/ location and has not been moved into
# /cdimage/archive/, so it has no stable archive URL yet (re-verified 2026-07-31:
# archive/13.6.0 -> 404, debian-cd/13.6.0 -> 200). The SHA-256 below was taken
# from the archive's SHA256SUMS and its detached signature verified with gpgv
# against the Debian CD signing key DF9B9C49EAA9298432589D76DA87E80D6294BE9B
# ("Good signature from Debian CD signing key <debian-cd@lists.debian.org>").
PLEBIAN_OS_NETINST_URL=https://cdimage.debian.org/cdimage/archive/13.5.0/amd64/iso-cd/debian-13.5.0-amd64-netinst.iso
PLEBIAN_OS_NETINST_SHA256=95838884f5ea6c82421dfe6baaa5a639dbbe6756c1e380f9fe7a7cb0c1949d2a

# Advanced from 0.1.2's 20260712T000000Z. The trixie base suite is byte-identical
# at both timestamps (both resolve to the same Release file, Version 13.6, dated
# 2026-07-11), but trixie-security and trixie-updates have moved on
# (2026-07-11 -> 2026-07-26), so this picks up two weeks of security updates.
# The trixie, trixie-updates, and trixie-security snapshot InRelease signatures
# were re-verified against Debian's archive keyring on 2026-07-31.
PLEBIAN_OS_APT_SNAPSHOT=20260727T000000Z

# Verified fallback engine. First boot builds the clickable fork over it.
#
# Held at 0.47.4 deliberately: it matches the base of the pinned kitty fork
# (src is v0.47.4-183-g05731a901) and is the engine the 0.1.2 image was
# acceptance-tested with. Upstream kitty is now 0.48.1; moving the fallback a
# minor version ahead of the fork changes which kitty.conf options the fallback
# accepts and deserves its own testing cycle, not a release-day bump.
# SHA-256 re-derived 2026-07-31 by downloading the release asset.
KILIX_PREBUILT_VERSION=0.47.4
KILIX_PREBUILT_SHA256=bc230142b2bd27f2a4bf1b1b67575f3d397a4ea2cc83f4ac2b912c306a939693
PLEBIAN_OS_BUILD_KILIX_FORK=1

# Exact official Go archives used to build the fork on either supported host
# architecture. Pleb records and verifies their installed source provenance.
#
# go1.26.5 matches the `toolchain go1.26.5` line in the pinned Kilix commit's
# src/go.mod, and is still the newest 1.26.x stable. Both hashes re-verified
# 2026-07-31 against https://go.dev/dl/?mode=json. RE-CHECK src/go.mod once
# KILIX_REF is final: if the fork's toolchain line has moved, this version and
# both hashes must move with it.
PLEBIAN_OS_KILIX_GO_MIN_VERSION=1.26
PLEBIAN_OS_KILIX_GO_VERSION=go1.26.5
PLEBIAN_OS_KILIX_GO_SHA256_AMD64=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053
PLEBIAN_OS_KILIX_GO_SHA256_ARM64=fe4789e92b1f33358680864bbe8704289e7bb5fc207d80623c308935bd696d49

# Release session contract: login to the visibly identifiable main Kilix
# instance, with its page and pane chrome present, never a hard kiosk.
# `kilix desktop` remains available in its own tab and selects the exact
# authoritative Kilix-95 provider with the 95 flavor, not the XP flavor.
PLEBIAN_OS_DESKTOP=0
PLEBIAN_OS_KIOSK=0
KILIX_DESKTOP_PROVIDER=external
KILIX_DESKTOP_FLAVOR=95
KILIX95_AUTO_INSTALL=1

# Optional remote installer execution stays disabled in the release closure.
PLEBIAN_OS_INSTALL_UV=0

# ── Kilix Voice (new in 0.1.6) ──────────────────────────────────────────────
# Read-aloud and dictation. Empty means the closure the pinned Kilix commit
# already carries, which that commit makes immutable — this is a deliberate
# default, not an unfilled pin. Set KILIX_VOICE_REF and the libvosk/model pins
# only to override that closure; if they are set, the model URL and its SHA-256
# must be verified from their upstream source like every other pin here.
KILIX_VOICE_REF=
KILIX_VOICE_LIB_VERSION=
KILIX_VOICE_LIB_SHA=
KILIX_VOICE_MODEL_URL=
KILIX_VOICE_MODEL_SHA=

# Read-aloud always provisions; the speech library and acoustic model are the
# optional half. 1 keeps dictation in the image.
PLEBIAN_OS_INSTALL_VOICE_MODEL=1
