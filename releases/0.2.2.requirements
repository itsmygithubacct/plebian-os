# Plebian-OS 0.2.2 release requirements.
#
# These are not a partial release manifest. The final releases/0.2.2.env must
# declare these exact values in addition to the complete coordinated closure.
# Both the release-image loader and closure selector reject a mismatch.
#
# uv 0.12.5 was released by Astral on 2026-08-14. The installer checksum was
# independently derived from both official versioned installer endpoints:
#   https://astral.sh/uv/0.12.5/install.sh
#   https://releases.astral.sh/github/uv/releases/download/0.12.5/uv-installer.sh

# The 2026-08-25 latest-stable recheck retained Debian 13.5.0 as the newest
# immutable archived amd64 netinst. Debian 13.6.0 is current, but has no
# archive URL yet. The signed snapshot remains the accepted 13.6-era package
# closure, independent of the bootstrap media version.
PLEBIAN_OS_NETINST_URL=https://cdimage.debian.org/cdimage/archive/13.5.0/amd64/iso-cd/debian-13.5.0-amd64-netinst.iso
PLEBIAN_OS_NETINST_SHA256=95838884f5ea6c82421dfe6baaa5a639dbbe6756c1e380f9fe7a7cb0c1949d2a
PLEBIAN_OS_NETINST_MAX_BYTES=791674880
PLEBIAN_OS_APT_SNAPSHOT=20260727T000000Z

PLEBIAN_OS_INSTALL_UV=1
PLEBIAN_OS_UV_VERSION=0.12.5
PLEBIAN_OS_UV_INSTALLER_SHA256=504511fbbbd811aeaba6738abc79408956b6c7da0ca35437b3dcc24a41efc111
PLEBIAN_OS_UV_INSTALLER_MAX_BYTES=71225

# Preserve the accepted privileged first-use helper without putting Android,
# Weston, or their large image closure in the base package set.
PLEBIAN_OS_INSTALL_WAYDROID=1
PLEBIAN_OS_WAYDROID_CLOSURE_SHA256=4ad7a4d44eef6ce4e90173491d0c6c8da02b3764d0d20d1df67ca7eeaa7e4175

# The RC6 model compliance carrier and the licence interface it binds. Two
# independent RC6 review seats are bound by the acceptance receipt; runtime,
# image and final release acceptance remain separate gates.
# A carrier change moves these pins in both files (AC-12).
PLEBIAN_OS_VOICE_CARRIER_DIR=releases/0.2.2-model-compliance
PLEBIAN_OS_VOICE_CARRIER_SHA256=39694d149a66aaf412d561e3954867773db2a1dfffe6eaa9551338f14eb69279
PLEBIAN_OS_VOICE_CARRIER_RECEIPT_SHA256=1768840ba44e2a2e80019a1b39d9955943694d99ea24aa8bc2c7f51d6f5c8aa1
KILIX_LICENSE_REF=0566f50ac53de6d55e2c7507fd601735eb4e28f7
PLEBIAN_OS_VOICE_CARRIER_CONTENT_REF=2a4d3bdbd504063cf9bdb971a2e92825884e166d

# The qualified RC6 QtGui/XcbQpa/XCB plugin delivery.
PLEBIAN_OS_QT_RUNTIME_URL=https://github.com/itsmygithubacct/plebian-os/releases/download/qt-runtime-rc6/qt-runtime-rc6.tar.xz
PLEBIAN_OS_QT_RUNTIME_SHA256=623b5f2669fbf42679694ca5c8d3f841536a1f2bc449d66166f057650c8f4ad1
PLEBIAN_OS_QT_RUNTIME_BYTES=6708392
