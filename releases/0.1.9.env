# Plebian-OS 0.1.9 — authoritative coordinated candidate closure.
#
# These exact source commits and third-party inputs were frozen and verified on
# 2026-08-12. PLEBIAN_OS_REF is self-referential until this release commit is
# tagged; installed systems persist the resolved commit rather than the tag.

PLEBIAN_OS_VERSION=0.1.9
PLEBIAN_OS_RELEASE_MODE=1

# Published installer login policy.
IMAGE_PASSWORD=plebian
