# Plebian-OS 0.2.3 RC8 candidate environment.
#
# STATUS: PLEBIAN_OS_REF names the local annotated candidate v0.2.3-rc8.
# It follows the published tag v0.2.3-rc7 (commit b7e7e0d3). This tag is
# local and is not pushed. RC8 acceptance is not claimed.
# Ask default is lfm2-kilix-v5e1-wse-20261106.9. Help default is
# kilix-qwen-sft1-2b. The optional qwen-0.8b-no-loop-02 chat model remains
# through kilix-llm. Fresh-install, BIOS, and EFI acceptance of RC8 are
# not claimed. Image upgrade, standalone upgrade, rollback, and user-data
# preservation are not claimed here. The kilix-diarization-cpu
# notice licensors match the licence-record string a receipt binds.
#
# Every component *_REF except PLEBIAN_OS_REF is a bare 40-character SHA.
# PLEBIAN_OS_REF is the local annotated tag v0.2.3-rc8. The same *_REF values
# are mirrored in the closure table of releases/0.2.3-notes.md.
# Where a pin moved since 0.2.2 the comment above it says from what and to
# what. Where it did not move the comment says held.

# Numeric release with an explicit local RC8 tag. Not pushed.
PLEBIAN_OS_VERSION=0.2.3
PLEBIAN_OS_RELEASE_MODE=1
# Local annotated RC8 tag. Not pushed. RC8 acceptance is not claimed.
PLEBIAN_OS_REF=v0.2.3-rc8
PLEBIAN_OS_REPO=https://github.com/itsmygithubacct/plebian-os.git
PLEBIAN_OS_BRANCH=
# Advanced from 0.2.2's 2dd44b003b1d0d0ca4b06aa2721467590b5f71f7.
# 92c81c0 is one commit after the RC1 candidate 6e4b755 and names the Kilix Secrets settings.
PLEB_REF=92c81c0e11f5b298b75dfb45394f9d47ed3dab77
PLEB_REPO=https://github.com/itsmygithubacct/pleb.git
PLEB_BRANCH=
# Advanced from 3da4f21a9730b5ff46824db8e92a65e3b6ae11a7, which advanced from 763e6e88a16cc3c6f56ba7b3a343715389b8ecae and the published RC7 pin 55d7ea2ab00d83bd4ddeff674dee86cf7c5a8897. The kilix-content gitlink stays b0c6f650aa6878381758905afb97087519bc0692.
# It pins kilix-llm 93f2202be062cb443daf9a3d47243098d9567bf6 (pull of qwen-0.8b-no-loop-02 is refused; the runtime build does not fetch the web UI) and kilix-avatar 202f03cd2834c7979f9399d6e03caa823786d2dd.
# Ask answers a closed sum, the time, disk, memory, CPU, one sensor reading, volume, brightness, the network name, the current track, and an alarm directly. kilix ask --repl stays open until exit, quit, or EOF. The kilix-telemetry gitlink is 12574bbd20caf44e1fdea5cf7354a4bf2c7124d1.
KILIX_REF=388c49436c469f8755265296d064be2e77678b0f
KILIX_REPO=https://github.com/itsmygithubacct/kilix.git
KILIX_BRANCH=
# Advanced from a9f28965d5994d43fed7992bae794ee9885466b2 (the published RC7 pin). Pairs CI with KILIX_REF. The no-loop entries are unchanged.
KILIX95_REF=a4e73d0595a677430fae1d67bc3284bcfe097c00
KILIX95_REPO=https://github.com/itsmygithubacct/kilix-95.git
KILIX95_BRANCH=
# Held from 0.2.2.
KILIX_SYSTEM_MONITOR_REF=9316bc2631958f5dcdb3588012d9baca7be1566d
KILIX_SYSTEM_MONITOR_REPO=https://github.com/itsmygithubacct/kilix-system-monitor.git
KILIX_SYSTEM_MONITOR_BRANCH=
