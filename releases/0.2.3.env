# Plebian-OS 0.2.3 RC6 candidate environment.
#
# STATUS: PLEBIAN_OS_REF names the local annotated candidate v0.2.3-rc6.
# Ask default is lfm2-kilix-v5e1-wse-20261106.9. Help default is
# kilix-qwen-sft1-2b. Fresh-install, BIOS, and EFI acceptance are the gates
# this candidate is entering. Image upgrade, standalone upgrade, rollback,
# and user-data preservation are not claimed here. The kilix-diarization-cpu
# notice licensors match the licence-record string a receipt binds.
#
# Every component *_REF except PLEBIAN_OS_REF is a bare 40-character SHA.
# PLEBIAN_OS_REF is the local annotated tag v0.2.3-rc6. The same *_REF values
# are mirrored in the closure table of releases/0.2.3-notes.md.
# Where a pin moved since 0.2.2 the comment above it says from what and to
# what. Where it did not move the comment says held.

# Numeric release with an explicit RC6 tag for this local upgrade.
PLEBIAN_OS_VERSION=0.2.3
PLEBIAN_OS_RELEASE_MODE=1
# Local annotated RC6 tag. Whole-release acceptance remains open.
PLEBIAN_OS_REF=v0.2.3-rc6
PLEBIAN_OS_REPO=https://github.com/itsmygithubacct/plebian-os.git
PLEBIAN_OS_BRANCH=
# Advanced from 0.2.2's 2dd44b003b1d0d0ca4b06aa2721467590b5f71f7.
# 92c81c0 is one commit after the RC1 candidate 6e4b755 and names the Kilix Secrets settings.
PLEB_REF=92c81c0e11f5b298b75dfb45394f9d47ed3dab77
PLEB_REPO=https://github.com/itsmygithubacct/pleb.git
PLEB_BRANCH=
# Advanced from c90d48efab8c79a0011c9737fa9747f22fe98837 (Playalong's default models, their opt-out and its refused-licence decline, over 44b992ae's whisper-medium-en, transcribe, split and round-3 wording fixes): kitty-pty-broker a5a5f2d3, which reaps descendants adopted behind its subreaper boundary while the pane lives. The kilix-content gitlink is c8f0b0f51966925c5872c70c246434cce6784982.
KILIX_REF=beb39587b42cdf89ea0c62258c9ba044d05baa1b
KILIX_REPO=https://github.com/itsmygithubacct/kilix.git
KILIX_BRANCH=
