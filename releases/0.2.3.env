KILIX_WAYDROID_REF=9d1803dfe3c148d8823fa21335460b0c7677ef5b
KILIX_WAYDROID_REPO=https://github.com/itsmygithubacct/kilix-waydroid.git
KILIX_WAYDROID_BRANCH=
# F112 kilix-secrets. Published main, which contains the H0 production point
# (ops 4, 512 MiB) and the Review B acceptance record. Not the encodec native deb.
KILIX_SECRETS_REF=da05600d9b52074281218b97da041a93fac22ece
KILIX_SECRETS_REPO=https://github.com/itsmygithubacct/kilix-secrets.git
KILIX_SECRETS_BRANCH=
# Debian 13.7.0 amd64 netinst. Use the local file only when its sha256 matches the pin below.
PLEBIAN_OS_NETINST_URL=https://cdimage.debian.org/debian-cd/13.7.0/amd64/iso-cd/debian-13.7.0-amd64-netinst.iso
PLEBIAN_OS_NETINST_SHA256=a7ef94ac2fb9a7fec454552abd629b7cc9d5155c886165a45649f5ce6167e355
PLEBIAN_OS_NETINST_MAX_BYTES=792723456
# Empty selects live Debian sources through installation and first boot.
PLEBIAN_OS_APT_SNAPSHOT=
KILIX_PREBUILT_VERSION=0.48.2
KILIX_PREBUILT_SHA256=967a1958e7fc67b495d279c0963bcd1a0482097151817ce6506fabc822689af7
PLEBIAN_OS_BUILD_KILIX_FORK=1
PLEBIAN_OS_KILIX_GO_MIN_VERSION=1.26
# go.dev go1.27.3 (2026-10-19). 1.27.2 and 1.27.3 are security releases. A fresh
# install builds the Kilix engine with it; pleb checks Go only when it rebuilds
# the engine, so an upgrade with an unchanged engine source keeps its Go.
PLEBIAN_OS_KILIX_GO_VERSION=go1.27.3
PLEBIAN_OS_KILIX_GO_SHA256_AMD64=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
PLEBIAN_OS_KILIX_GO_SHA256_ARM64=a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49
PLEBIAN_OS_DESKTOP=1
PLEBIAN_OS_KIOSK=0
KILIX_DESKTOP_PROVIDER=external
KILIX_DESKTOP_FLAVOR=95
KILIX95_AUTO_INSTALL=1
KILIX_RUN_ALIASES=1
PLEBIAN_OS_INSTALL_UV=1
PLEBIAN_OS_UV_VERSION=0.12.5
PLEBIAN_OS_UV_INSTALLER_SHA256=504511fbbbd811aeaba6738abc79408956b6c7da0ca35437b3dcc24a41efc111
PLEBIAN_OS_UV_INSTALLER_MAX_BYTES=71225
