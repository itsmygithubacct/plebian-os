# What each binary package installs: PACKAGE MODE SOURCE DESTINATION.
# debian/rules installs exactly these rows and nothing else.
# tests/test_debian_packaging.py holds this list equal to the set of files
# plebian-os-update deploys, so the packages and the updater cannot drift.
# @VERSION@ is the content of the top-level VERSION file.

plebian-os-release   0644 VERSION                                             /usr/share/plebian-os/VERSION
plebian-os-release   0644 releases/@VERSION@.env                              /usr/share/plebian-os/ollama-release.env

